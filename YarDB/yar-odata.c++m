export module yar:odata;
import :details;
import :engine;
import :constants;
import std;
import net;
import xson;

// OData protocol support for HTTP server
// This module contains all OData-specific functionality

namespace yar::http::odata {

using namespace std::string_literals;
using namespace std::string_view_literals;
using namespace net;
using namespace yar::http::details; // Use functions from details module

// Enum for OData metadata level
enum class metadata_level
{
    none,           // No metadata (plain JSON)
    minimal,        // Only @odata.context
    full            // All metadata (@odata.context, @odata.type, @odata.id, etc.)
};

// Helper function to parse OData metadata level from Accept header
// Returns the metadata level requested, or 'none' if not specified
// Note: Header values are already normalized (lowercase) by the http::headers class
inline auto parse_metadata_level(const ::http::headers& headers)
{
    if(!headers.contains("accept"s))
        return metadata_level::none;
    
    const auto accept_value = headers["accept"s];
    
    // Check for odata=fullmetadata
    if(accept_value.contains("odata=fullmetadata"s))
        return metadata_level::full;
    
    // Check for odata=minimalmetadata
    if(accept_value.contains("odata=minimalmetadata"s))
        return metadata_level::minimal;
    
    // Check for odata=nometadata (explicit no metadata)
    if(accept_value.contains("odata=nometadata"s))
        return metadata_level::none;
    
    // Default: no metadata
    return metadata_level::none;
}

// Helper function to add OData metadata to a document based on metadata level
// For minimal metadata: adds @odata.context
// For full metadata: adds @odata.context, @odata.id, @odata.editLink
inline auto add_metadata(xson::object document, metadata_level level, 
                         std::string_view collection_name,
                         std::optional<xson::integer_type> id = std::nullopt)
{
    if(level == metadata_level::none)
        return document; // No metadata needed
    
    // OData context format:
    // - For entity sets (arrays): /$metadata#EntitySetName
    // - For single entities: /$metadata#EntitySetName/$entity
    auto context_url = "/$metadata#"s + std::string{collection_name};
    if(id.has_value())
        context_url += "/$entity"s; // Single entity
    
    if(level == metadata_level::minimal)
    {
        // Minimal metadata: only @odata.context
        document["@odata.context"s] = context_url;
        return document;
    }
    
    // Full metadata: @odata.context, @odata.id, @odata.editLink
    document["@odata.context"s] = context_url;
    
    if(id.has_value())
    {
        auto resource_path = "/"s + std::string{collection_name} + "/"s + std::to_string(id.value());
        document["@odata.id"s] = resource_path;
        document["@odata.editLink"s] = resource_path;
    }
    
    return document;
}

// Helper function to add OData metadata to an array response
// Wraps the array in an object with @odata.context and "value" array
// For full metadata, also adds metadata to each item in the array
inline auto add_metadata_to_array(xson::object document, metadata_level level,
                                   std::string_view collection_name)
{
    if(level == metadata_level::none)
        return document; // No metadata needed
    
    if(!document.is_array())
        return document; // Not an array, return as-is
    
    // Wrap array in object with @odata.context and value
    auto context_url = "/$metadata#"s + std::string{collection_name};
    auto wrapped = xson::object{};
    wrapped["@odata.context"s] = context_url;
    wrapped["value"s] = document;
    
    // For full metadata, also add metadata to each item
    if(level == metadata_level::full)
    {
        auto& items = wrapped["value"s].get<xson::object::array>();
        for(auto& item : items)
        {
            if(item.has("_id"s))
            {
                auto item_id = static_cast<xson::integer_type>(item["_id"s]);
                item = add_metadata(item, level, collection_name, item_id);
            }
        }
    }
    
    return wrapped;
}

// Helper function to extract field name from function arguments (e.g., "field, 'value'" -> "field")
constexpr auto parse_field_from_function_args(std::string_view args, std::size_t comma_pos)
{
    return utils::trim_end(args.substr(0, comma_pos));
}

// Helper function to extract value without quotes from function arguments (e.g., "field, 'value'" -> "value")
constexpr auto parse_value_from_function_args(std::string_view args, std::size_t comma_pos)
{
    auto value_trimmed = utils::trim_start(args.substr(comma_pos + 1));
    
    // Remove quotes if present using string_view operations
    if(value_trimmed.size() >= 2)
    {
        if((value_trimmed.starts_with('\'') && value_trimmed.ends_with('\'')) ||
           (value_trimmed.starts_with('"') && value_trimmed.ends_with('"')))
        {
            return value_trimmed.substr(1, value_trimmed.size() - 2);
        }
    }
    
    return value_trimmed;
}

// String filter function type for post-processing
export struct string_filter
{
    std::string_view function;  // "startswith", "contains", "endswith" (string literals)
    std::string_view field;     // Field name (from parsed filter expression, points into original filter string)
    std::string_view value;     // Filter value (from parsed filter expression, points into original filter string)
};

// One branch of an OData OR expression (selector AND string filters within the branch)
export struct filter_branch
{
    xson::object selector;
    std::vector<string_filter> string_filters;
};

// Parsed $filter: either a single AND-group or multiple OR branches (OData: AND binds tighter than OR)
export struct parsed_filter
{
    xson::object and_selector;
    std::vector<string_filter> and_string_filters;
    std::vector<filter_branch> or_branches;

    [[nodiscard]] bool has_or() const noexcept
    {
        return not or_branches.empty();
    }
};

// Split comma-separated OData list values, respecting quoted strings
inline auto split_comma_separated_values(std::string_view list)
{
    auto result = std::vector<std::string_view>{};
    auto start = std::size_t{0};
    auto in_quote = false;
    auto quote_char = char{'\0'};

    for(auto i = std::size_t{0}; i < list.size(); ++i)
    {
        const auto c = list[i];
        if(in_quote)
        {
            if(c == quote_char)
                in_quote = false;
        }
        else if(c == '\'' || c == '"')
        {
            in_quote = true;
            quote_char = c;
        }
        else if(c == ',')
        {
            auto token = utils::trim(list.substr(start, i - start));
            if(not token.empty())
                result.push_back(token);
            start = i + 1;
        }
    }

    auto token = utils::trim(list.substr(start));
    if(not token.empty())
        result.push_back(token);

    return result;
}

// Parse OData 'in' list: ('active','pending') or (1, 2, 3)
inline auto parse_in_value_list(std::string_view list_content)
{
    auto tokens = split_comma_separated_values(list_content);
    if(tokens.empty())
        throw std::invalid_argument{"'in' operator requires at least one value"};

    enum class value_kind { string, integer };
    auto kind = std::optional<value_kind>{};
    auto values = std::vector<xson::object>{};

    for(const auto token : tokens)
    {
        auto is_string = false;
        auto raw = std::string_view{token};

        if(raw.size() >= 2 &&
           ((raw.front() == '\'' && raw.back() == '\'') ||
            (raw.front() == '"' && raw.back() == '"')))
        {
            raw = raw.substr(1, raw.size() - 2);
            is_string = true;
        }

        if(is_string)
        {
            if(kind && *kind != value_kind::string)
                throw std::invalid_argument{"'in' operator values must be all strings or all numbers"};
            kind = value_kind::string;
            values.emplace_back(utils::trim_end_to_string(raw));
        }
        else
        {
            try
            {
                if(kind && *kind != value_kind::integer)
                    throw std::invalid_argument{"'in' operator values must be all strings or all numbers"};
                kind = value_kind::integer;
                values.emplace_back(utils::stoll(std::string{raw}));
            }
            catch(const std::invalid_argument&)
            {
                throw;
            }
            catch(...)
            {
                throw std::invalid_argument{"Invalid numeric value in 'in' list: "s + std::string{token}};
            }
        }
    }

    return values;
}

// Split OData property path: Customer/Country -> ["Customer", "Country"]
inline auto split_property_path(std::string_view path)
{
    auto segments = std::vector<std::string>{};
    auto start = std::size_t{0};

    while(start <= path.size())
    {
        const auto slash = path.find('/', start);
        const auto end = slash == std::string_view::npos ? path.size() : slash;
        const auto segment = utils::trim(path.substr(start, end - start));

        if(segment.empty())
            throw std::invalid_argument{"Invalid property path: "s + std::string{path}};

        segments.emplace_back(segment);
        if(slash == std::string_view::npos)
            break;
        start = slash + 1;
    }

    if(segments.empty())
        throw std::invalid_argument{"Property path cannot be empty"};

    return segments;
}

// Deep-merge selector maps (needed when AND combines Customer/Country and Customer/Name)
inline void merge_selector_into(xson::object& target, const xson::object& source)
{
    for(const auto& [key, value] : source.get<db::object::map>())
    {
        if(target.has(key) && target[key].has_objects() && value.has_objects())
        {
            auto nested = target[key];
            merge_selector_into(nested, value);
            target[key] = std::move(nested);
        }
        else
            target[key] = value;
    }
}

// Set a leaf constraint at a possibly nested path (Customer/Country -> {Customer:{Country:leaf}})
inline void set_nested_selector_leaf(xson::object& selector, std::string_view path, xson::object leaf)
{
    const auto segments = split_property_path(path);

    if(segments.size() == 1)
    {
        if(selector.has(segments[0]) && selector[segments[0]].has_objects() && leaf.has_objects())
        {
            auto nested = selector[segments[0]];
            merge_selector_into(nested, leaf);
            selector[segments[0]] = std::move(nested);
        }
        else
            selector[segments[0]] = std::move(leaf);
        return;
    }

    auto nested = std::move(leaf);
    for(auto i = segments.size(); i-- > 1;)
    {
        auto wrapper = xson::object{};
        wrapper[segments[i]] = std::move(nested);
        nested = std::move(wrapper);
    }

    auto top = xson::object{};
    top[segments[0]] = std::move(nested);

    if(selector.has(segments[0]) && selector[segments[0]].has_objects())
        merge_selector_into(selector[segments[0]], top[segments[0]]);
    else
        selector[segments[0]] = std::move(top[segments[0]]);
}

// Resolve nested document field for string filter post-processing
inline const xson::object* get_field_by_path(const xson::object& document, std::string_view path)
{
    const auto segments = split_property_path(path);
    const xson::object* current = &document;

    for(std::size_t i = 0; i < segments.size(); ++i)
    {
        if(not current->has(segments[i]))
            return nullptr;

        const auto& next = (*current)[segments[i]];
        if(i + 1 == segments.size())
            return &next;

        if(not next.has_objects())
            return nullptr;

        current = &next;
    }

    return nullptr;
}

// Build xson $in map (xson match uses map keys, not arrays)
inline auto make_in_selector(std::string_view field, const std::vector<xson::object>& values)
{
    auto in_map = xson::object{};
    for(std::size_t i = 0; i < values.size(); ++i)
        in_map[std::to_string(i)] = values[i];

    auto selector = xson::object{};
    set_nested_selector_leaf(selector, field, xson::object{{"$in"s, std::move(in_map)}});
    return selector;
}

// Helper function to split filter expression by operator and process parts
inline auto split_and_process_filter_parts(std::string_view expr, std::string_view op_str, std::size_t op_len)
{
    auto parts = std::vector<std::string_view>{};
    auto start = std::size_t{0};
    
    while(true)
    {
        auto pos = expr.find(op_str, start);
        if(pos == std::string_view::npos)
        {
            parts.push_back(expr.substr(start));
            break;
        }
        parts.push_back(expr.substr(start, pos - start));
        start = pos + op_len;
    }
    
    return parts;
}

using filter_clause = std::pair<xson::object, std::vector<string_filter>>;

// Parse a single leaf $filter expression (no top-level and/or)
inline filter_clause parse_filter_leaf(std::string_view filter_expr)
{
    auto selector = xson::object{};
    auto string_filters = std::vector<string_filter>{};
    auto expr = utils::trim(filter_expr);

    // Handle 'in' operator: field in ('a','b') or field in (1, 2, 3)
    constexpr auto in_marker = " in ("sv;
    if(const auto in_pos = expr.find(in_marker); in_pos != std::string_view::npos)
    {
        if(not expr.ends_with(')'))
            throw std::invalid_argument{"Invalid 'in' expression: "s + std::string{expr}};

        auto field = utils::trim(expr.substr(0, in_pos));
        if(field.empty())
            throw std::invalid_argument{"Field name cannot be empty in 'in' expression: "s + std::string{expr}};

        const auto list_start = in_pos + in_marker.size();
        const auto list_content = expr.substr(list_start, expr.size() - list_start - 1);
        const auto values = parse_in_value_list(list_content);
        return std::make_pair(make_in_selector(field, values), string_filters);
    }
    
    // Check for string functions: startswith(field, 'value'), contains(field, 'value'), endswith(field, 'value')
    constexpr auto startswith_prefix = "startswith("sv;
    constexpr auto contains_prefix = "contains("sv;
    constexpr auto endswith_prefix = "endswith("sv;
    
    if(expr.starts_with(startswith_prefix) && expr.back() == ')')
    {
        // Parse: startswith(field, 'value')
        auto inner = expr.substr(startswith_prefix.size(), expr.size() - startswith_prefix.size() - 1);
        auto comma_pos = inner.find(',');
        if(comma_pos == std::string_view::npos)
            throw std::invalid_argument{"Invalid startswith expression: " + std::string{expr}};
        
        auto field = parse_field_from_function_args(inner, comma_pos);
        auto value = parse_value_from_function_args(inner, comma_pos);
        
        string_filters.push_back({"startswith", field, value});
        return std::make_pair(selector, string_filters);
    }
    else if(expr.starts_with(contains_prefix) && expr.back() == ')')
    {
        // Parse: contains(field, 'value')
        auto inner = expr.substr(contains_prefix.size(), expr.size() - contains_prefix.size() - 1);
        auto comma_pos = inner.find(',');
        if(comma_pos == std::string_view::npos)
            throw std::invalid_argument{"Invalid contains expression: " + std::string{expr}};
        
        auto field = parse_field_from_function_args(inner, comma_pos);
        auto value = parse_value_from_function_args(inner, comma_pos);
        
        string_filters.push_back({"contains", field, value});
        return std::make_pair(selector, string_filters);
    }
    else if(expr.starts_with(endswith_prefix) && expr.back() == ')')
    {
        // Parse: endswith(field, 'value')
        auto inner = expr.substr(endswith_prefix.size(), expr.size() - endswith_prefix.size() - 1);
        auto comma_pos = inner.find(',');
        if(comma_pos == std::string_view::npos)
            throw std::invalid_argument{"Invalid endswith expression: " + std::string{expr}};
        
        auto field = parse_field_from_function_args(inner, comma_pos);
        auto value = parse_value_from_function_args(inner, comma_pos);
        
        string_filters.push_back({"endswith", field, value});
        return std::make_pair(selector, string_filters);
    }
    
    // Find operator for comparison expressions
    // Operators are searched in order of specificity (longer first to avoid partial matches)
    constexpr std::string_view operators[] = {" ge ", " le ", " gt ", " lt ", " ne ", " eq "};
    constexpr std::string_view op_names[] = {"ge", "le", "gt", "lt", "ne", "eq"};
    
    auto op_pos = std::string_view::npos;
    std::string_view op;
    
    for(std::size_t i = 0; i < std::size(operators); ++i)
    {
        // Operators include spaces (" ge ", " eq ", etc.) so find() is safe - won't match partial words
        // e.g., "age" won't match " ge " because it lacks the leading space
        if(auto pos = expr.find(operators[i]); pos != std::string_view::npos)
        {
            op_pos = pos;
            op = op_names[i];
            break;
        }
    }
    
    if(op_pos == std::string_view::npos)
        throw std::invalid_argument{"Invalid filter expression: "s + std::string{expr}};
    
    auto field = utils::trim_end_to_string(expr.substr(0, op_pos));
    auto value = utils::trim_start_to_string(expr.substr(op_pos + op.size() + 1));
    
    // Validate field name is not empty
    if(field.empty())
        throw std::invalid_argument{"Field name cannot be empty in filter expression: "s + std::string{expr}};
    
    // Remove quotes from string values first
    auto is_string = false;
    if(value.size() >= 2 && value[0] == '\'' && value.back() == '\'')
    {
        value = value.substr(1, value.size() - 2);
        is_string = true;
    }
    else if(value.size() >= 2 && value[0] == '"' && value.back() == '"')
    {
        value = value.substr(1, value.size() - 2);
        is_string = true;
    }
    
    // Validate value is not empty (empty strings are allowed for string comparisons)
    if(value.empty() && !is_string)
        throw std::invalid_argument{"Filter value cannot be empty in filter expression: "s + std::string{expr}};
    
    // Convert to selector format (supports nested paths: Customer/Country)
    if(op == "eq")
    {
        if(is_string)
            set_nested_selector_leaf(selector, field, xson::object{value});
        else
        {
            try
            {
                auto num = utils::stoll(value);
                set_nested_selector_leaf(selector, field, xson::object{num});
            }
            catch(...)
            {
                set_nested_selector_leaf(selector, field, xson::object{value});
            }
        }
    }
    else if(op == "ne")
    {
        if(is_string)
            set_nested_selector_leaf(selector, field, xson::object{{"$ne"s, value}});
        else
        {
            try
            {
                auto num = utils::stoll(value);
                set_nested_selector_leaf(selector, field, xson::object{{"$ne"s, num}});
            }
            catch(...)
            {
                set_nested_selector_leaf(selector, field, xson::object{{"$ne"s, value}});
            }
        }
    }
    else if(op == "gt")
    {
        try
        {
            auto num = stoll(value);
            set_nested_selector_leaf(selector, field, xson::object{{"$gt"s, num}});
        }
        catch(const std::exception&)
        {
            throw std::invalid_argument{"Numeric operator 'gt' requires numeric value in filter expression: "s + std::string{expr}};
        }
    }
    else if(op == "ge")
    {
        try
        {
            auto num = stoll(value);
            set_nested_selector_leaf(selector, field, xson::object{{"$gte"s, num}});
        }
        catch(const std::exception&)
        {
            throw std::invalid_argument{"Numeric operator 'ge' requires numeric value in filter expression: "s + std::string{expr}};
        }
    }
    else if(op == "lt")
    {
        try
        {
            auto num = stoll(value);
            set_nested_selector_leaf(selector, field, xson::object{{"$lt"s, num}});
        }
        catch(const std::exception&)
        {
            throw std::invalid_argument{"Numeric operator 'lt' requires numeric value in filter expression: "s + std::string{expr}};
        }
    }
    else if(op == "le")
    {
        try
        {
            auto num = stoll(value);
            set_nested_selector_leaf(selector, field, xson::object{{"$lte"s, num}});
        }
        catch(const std::exception&)
        {
            throw std::invalid_argument{"Numeric operator 'le' requires numeric value in filter expression: "s + std::string{expr}};
        }
    }
    
    return std::make_pair(selector, string_filters);
}

// Parse AND-group: field eq 'x' and age gt 25 (no top-level OR)
inline filter_clause parse_filter_and_group(std::string_view filter_expr)
{
    auto expr = utils::trim(filter_expr);

    if(expr.contains(" and "))
    {
        constexpr auto op_str = " and "sv;
        auto parts = split_and_process_filter_parts(expr, op_str, op_str.size());

        auto selector = xson::object{};
        auto string_filters = std::vector<string_filter>{};

        for(const auto& part : parts)
        {
            auto [part_selector, part_string_filters] = parse_filter_and_group(part);
            merge_selector_into(selector, part_selector);
            string_filters.insert(string_filters.end(), part_string_filters.begin(), part_string_filters.end());
        }
        return std::make_pair(selector, string_filters);
    }

    return parse_filter_leaf(expr);
}

// Parse OData $filter expression
// Supports: comparisons, in, string functions, and (AND), or (OR — OData precedence: AND before OR)
export inline parsed_filter parse_filter(std::string_view filter_expr)
{
    auto expr = utils::trim(filter_expr);

    if(expr.contains(" or "))
    {
        constexpr auto op_str = " or "sv;
        auto parts = split_and_process_filter_parts(expr, op_str, op_str.size());

        auto branches = std::vector<filter_branch>{};
        branches.reserve(parts.size());

        for(const auto& part : parts)
        {
            auto [branch_selector, branch_string_filters] = parse_filter_and_group(part);
            branches.push_back({std::move(branch_selector), std::move(branch_string_filters)});
        }

        return parsed_filter{{}, {}, std::move(branches)};
    }

    auto [selector, string_filters] = parse_filter_and_group(expr);
    return parsed_filter{std::move(selector), std::move(string_filters), {}};
}

// Helper function to apply $select projection to documents
inline auto apply_select(const xson::object& documents, std::string_view select_value)
{
    // Parse comma-separated field list: "name,email,age"
    auto fields = parse_comma_separated_list(select_value);
    
    if(fields.empty())
        return documents; // No fields specified, return as-is
    
    // Apply projection
    if(!documents.is_array())
        return documents; // Not an array, return as-is
    
    auto result = xson::object{xson::object::array{}};
    const auto& docs = documents.get<xson::object::array>();
    
    for(const auto& doc : docs)
    {
        auto projected = xson::object{};
        // Always include _id if present
        if(doc.has("_id"s))
            projected["_id"s] = doc["_id"s];
        
        // Include requested fields
        for(const auto& field : fields)
        {
            if(doc.has(field))
                projected[field] = doc[field];
        }
        
        result += std::move(projected);
    }
    
    return result;
}

// Smallest string strictly greater than all strings with the given prefix (for index range scans)
export inline auto prefix_exclusive_upper_bound(std::string_view prefix) -> std::optional<std::string>
{
    if(prefix.empty())
        return std::nullopt;

    auto upper = std::string{prefix};
    while(not upper.empty())
    {
        auto& byte = upper.back();
        if(static_cast<unsigned char>(byte) < 0xFF)
        {
            ++byte;
            return upper;
        }
        upper.pop_back();
    }

    return std::nullopt;
}

// Lower startswith(field, prefix) to indexed {$gte, $lt} range when field is a top-level secondary key
export inline void lower_startswith_filters(
    yar::db::engine& engine,
    std::string_view collection,
    xson::object& selector,
    std::vector<string_filter>& string_filters)
{
    if(string_filters.empty())
        return;

    const auto indexed_keys = engine.indexed_keys(collection);
    auto indexed = std::unordered_set<std::string>{};
    indexed.reserve(indexed_keys.size());
    for(const auto& key : indexed_keys)
        indexed.insert(key);

    auto remaining = std::vector<string_filter>{};
    remaining.reserve(string_filters.size());

    for(const auto& filter : string_filters)
    {
        if(filter.function != "startswith"sv || filter.field.contains('/'))
        {
            remaining.push_back(filter);
            continue;
        }

        const auto field = std::string{filter.field};
        if(not indexed.contains(field) || selector.has(field))
        {
            remaining.push_back(filter);
            continue;
        }

        const auto prefix = std::string{filter.value};
        const auto upper = prefix_exclusive_upper_bound(prefix);
        if(not upper)
        {
            remaining.push_back(filter);
            continue;
        }

        set_nested_selector_leaf(
            selector,
            field,
            xson::object{{"$gte"s, prefix}, {"$lt"s, *upper}});
    }

    string_filters = std::move(remaining);
}

// Helper function to apply string filters to documents (post-processing)
inline auto apply_string_filters(const xson::object& documents, const std::vector<string_filter>& filters)
{
    if(filters.empty() || !documents.is_array())
        return documents;
    
    auto result = xson::object{xson::object::array{}};
    const auto& docs = documents.get<xson::object::array>();
    
    for(const auto& doc : docs)
    {
        auto matches = true;
        
        for(const auto& filter : filters)
        {
            const auto* field_value = get_field_by_path(doc, filter.field);
            if(field_value == nullptr || not field_value->is_string())
            {
                matches = false;
                break;
            }

            const std::string_view field = field_value->get<std::string>();
            
            if(filter.function == "startswith")
            {
                if(!field.starts_with(filter.value))
                {
                    matches = false;
                    break;
                }
            }
            else if(filter.function == "contains")
            {
                if(!field.contains(filter.value))
                {
                    matches = false;
                    break;
                }
            }
            else if(filter.function == "endswith")
            {
                if(!field.ends_with(filter.value))
                {
                    matches = false;
                    break;
                }
            }
            else
            {
                // Unknown filter function - reject document to be safe
                throw std::logic_error{"Unknown string filter function: "s + std::string{filter.function}};
            }
        }
        
        if(matches)
            result += doc;
    }
    
    return result;
}

// True when a document matches one OR branch (selector AND branch string filters)
export inline auto document_matches_branch(const xson::object& doc, const filter_branch& branch)
{
    if(not doc.match(branch.selector))
        return false;

    if(branch.string_filters.empty())
        return true;

    const auto wrapped = xson::object{xson::object::array{doc}};
    const auto filtered = apply_string_filters(wrapped, branch.string_filters);
    return filtered.is_array() and not filtered.get<xson::object::array>().empty();
}

// Union branch results, deduplicating by _id
export inline void merge_or_branch_documents(
    xson::object& merged,
    const xson::object& branch_docs,
    std::unordered_set<xson::integer_type>& seen_ids)
{
    if(not branch_docs.is_array())
        return;

    for(const auto& doc : branch_docs.get<xson::object::array>())
    {
        if(not doc.has("_id"s))
            continue;

        const auto id = static_cast<xson::integer_type>(doc["_id"s]);
        if(not seen_ids.insert(id).second)
            continue;

        merged += doc;
    }
}

// Apply $skip then $top to a document array (used after OR branch merge)
export inline auto apply_top_skip(
    xson::object documents,
    xson::integer_type skip,
    xson::integer_type top)
{
    if(not documents.is_array())
        return documents;

    auto& items = documents.get<xson::object::array>();

    if(skip > 0)
    {
        if(static_cast<std::size_t>(skip) >= items.size())
        {
            documents = xson::object{xson::object::array{}};
            return documents;
        }
        items.erase(items.begin(), items.begin() + static_cast<std::ptrdiff_t>(skip));
    }

    if(top >= 0 && static_cast<std::size_t>(top) < items.size())
        items.resize(static_cast<std::size_t>(top));

    return documents;
}

// Filter an in-memory array to documents matching any OR branch (unit tests)
export inline auto filter_documents_by_or(
    const xson::object& documents,
    const std::vector<filter_branch>& branches)
{
    if(not documents.is_array())
        return documents;

    auto result = xson::object{xson::object::array{}};
    auto seen_ids = std::unordered_set<xson::integer_type>{};

    for(const auto& doc : documents.get<xson::object::array>())
    {
        for(const auto& branch : branches)
        {
            if(document_matches_branch(doc, branch))
            {
                if(doc.has("_id"s))
                {
                    const auto id = static_cast<xson::integer_type>(doc["_id"s]);
                    if(not seen_ids.insert(id).second)
                        break;
                }
                result += doc;
                break;
            }
        }
    }

    return result;
}

// Count documents for $count=true — index-only when the parsed filter allows it
export inline auto count_with_parsed_filter(
    yar::db::engine& engine,
    std::string_view collection,
    xson::object query_selector,
    const parsed_filter& filter) -> std::size_t
{
    if(filter.has_or())
    {
        auto merged = xson::object{xson::object::array{}};
        auto seen_ids = std::unordered_set<xson::integer_type>{};

        for(auto branch : filter.or_branches)
        {
            lower_startswith_filters(engine, collection, branch.selector, branch.string_filters);
            auto branch_docs = xson::object{};
            engine.read(collection, branch.selector, branch_docs);
            auto filtered = apply_string_filters(branch_docs, branch.string_filters);
            merge_or_branch_documents(merged, filtered, seen_ids);
        }

        if(not merged.is_array())
            return 0;

        return merged.get<xson::object::array>().size();
    }

    merge_selector_into(query_selector, filter.and_selector);

    auto string_filters = filter.and_string_filters;
    lower_startswith_filters(engine, collection, query_selector, string_filters);

    if(not string_filters.empty())
    {
        auto documents = xson::object{};
        engine.read(collection, query_selector, documents);
        documents = apply_string_filters(documents, string_filters);
        if(not documents.is_array())
            return 0;

        return documents.get<xson::object::array>().size();
    }

    return engine.count(collection, query_selector);
}

// Execute $filter via engine.read — one read per OR branch, merged by _id
export inline auto read_with_parsed_filter(
    yar::db::engine& engine,
    std::string_view collection,
    xson::object query_selector,
    const parsed_filter& filter)
{
    if(filter.has_or())
    {
        auto top = std::numeric_limits<xson::integer_type>::max();
        auto skip = xson::integer_type{0};

        if(query_selector.has("$top"s))
            top = query_selector["$top"s];
        if(query_selector.has("$skip"s))
            skip = query_selector["$skip"s];

        auto merged = xson::object{xson::object::array{}};
        auto seen_ids = std::unordered_set<xson::integer_type>{};

        for(auto branch : filter.or_branches)
        {
            lower_startswith_filters(engine, collection, branch.selector, branch.string_filters);
            auto branch_docs = xson::object{};
            engine.read(collection, branch.selector, branch_docs);
            auto filtered = apply_string_filters(branch_docs, branch.string_filters);
            merge_or_branch_documents(merged, filtered, seen_ids);
        }

        return apply_top_skip(merged, skip, top);
    }

    merge_selector_into(query_selector, filter.and_selector);

    auto string_filters = filter.and_string_filters;
    lower_startswith_filters(engine, collection, query_selector, string_filters);

    auto documents = xson::object{};
    engine.read(collection, query_selector, documents);
    return apply_string_filters(documents, string_filters);
}

// Helper function to apply $expand to documents
// For now, this is a placeholder - YarDB doesn't have explicit relationships
inline auto apply_expand(const xson::object& documents, [[maybe_unused]] std::string_view expand_value, [[maybe_unused]] const std::string& collection_name, [[maybe_unused]] yar::db::engine& engine)
{
    // For now, $expand is a placeholder
