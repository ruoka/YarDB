export module yar:engine;
export import :db_error;
import :metadata;
import :index;
import std;
import xson;

export namespace yar::db {

using object = xson::object;

struct write_preconditions
{
    std::optional<position_type> if_match_position;
    std::optional<std::chrono::system_clock::time_point> if_unmodified_since;
};

// Durable identity of a live document version. Position is the ETag source;
// timestamp feeds Last-Modified. Captured under the same engine lock as the
// matching body so HTTP responses cannot pair a stale body with a fresh ETag.
struct document_revision
{
    std::optional<std::int64_t> position;
    std::optional<std::chrono::system_clock::time_point> timestamp;
};

// Sort a document array by a field (OData $orderby). Missing/non-primitive
// values sort after present ones; ties break on _id ascending. When descending,
// field order is reversed; missing values stay last.
void apply_orderby(object& documents, std::string_view field, bool descending);

// Database engine providing CRUD operations and indexing capabilities.
// Read operations use shared locking; writes use exclusive locking.
class engine
{
public:

    engine(std::string_view db = "./yar.db");
    engine(engine&&);
    ~engine();

//  Indexing

    db_result<> index(std::string_view collection, std::vector<std::string> keys);
    db_result<> reindex();
    std::vector<std::string> indexed_keys(std::string_view collection) const;

//  CRUD

    db_result<> create(
        std::string_view collection,
        object& document,
        document_revision* revision = nullptr);
    bool read(std::string_view collection, const object& selector, object& documents);
    // Like read(), and under the same shared lock fills revision from the first
    // document included in the result (index order; ignored when $orderby is set).
    bool read(
        std::string_view collection,
        const object& selector,
        object& documents,
        document_revision& revision);
    std::size_t count(std::string_view collection, const object& selector) const;
    std::optional<std::chrono::system_clock::time_point> metadata_timestamp(std::string_view collection, const object& selector) const;
    std::optional<std::int64_t> metadata_position(std::string_view collection, const object& selector) const;

    db_result<std::size_t> update(
        std::string_view collection,
        const object& selector,
        const object& updates,
        object& documents,
        write_preconditions preconditions = {},
        document_revision* revision = nullptr);

    db_result<std::size_t> destroy(
        std::string_view collection,
        const object& selector,
        object& documents,
        write_preconditions preconditions = {});

    bool history(std::string_view collection, const object& selector, object& documents);

    db_result<std::size_t> upsert(
        std::string_view collection,
        const object& selector,
        object& updates,
        object& documents);

    db_result<std::size_t> upsert(std::string_view collection, const object& selector, object& updates)
    {
        auto documents = object{};
        return upsert(collection, selector, updates, documents);
    }

    db_result<std::size_t> replace(
        std::string_view collection,
        const object& selector,
        object& document,
        write_preconditions preconditions = {},
        document_revision* revision = nullptr);

    db_result<std::size_t> update(std::string_view collection, const object& selector, const object& updates)
    {
        auto documents = object{};
        return update(collection, selector, updates, documents);
    }

    db_result<std::size_t> destroy(std::string_view collection, const object& selector)
    {
        auto documents = object{};
        return destroy(collection, selector, documents);
    }

    std::vector<std::string> collections() const
    {
        auto lock = std::shared_lock{m_rwlock};
        return m_index | std::views::keys | std::ranges::to<std::vector<std::string>>();
    }

private:

    class storage_lock
    {
    public:
        explicit storage_lock(const std::filesystem::path& database) :
            m_path{database.string() + ".pid"}
        {
            auto file = std::ofstream{m_path, std::ios::out | std::ios::noreplace};
            if(not file.is_open())
                throw std::runtime_error{"Database lock already exists: " + m_path.string()};

            file << std::chrono::system_clock::now().time_since_epoch().count() << '\n';
            file.flush();
            if(file.fail())
            {
                auto error = std::error_code{};
                std::filesystem::remove(m_path, error);
                throw std::runtime_error{"Failed to initialize database lock: " + m_path.string()};
            }
            m_owns_lock = true;
        }

        storage_lock(const storage_lock&) = delete;
        storage_lock& operator=(const storage_lock&) = delete;

        storage_lock(storage_lock&& other) noexcept :
            m_path{std::move(other.m_path)},
            m_owns_lock{std::exchange(other.m_owns_lock, false)}
        {}

        storage_lock& operator=(storage_lock&& other) noexcept
        {
            if(this != &other)
            {
                release();
                m_path = std::move(other.m_path);
                m_owns_lock = std::exchange(other.m_owns_lock, false);
            }
            return *this;
        }

        ~storage_lock()
        {
            release();
        }

    private:
        void release() noexcept
        {
            if(not std::exchange(m_owns_lock, false))
                return;

            auto error = std::error_code{};
            std::filesystem::remove(m_path, error);
        }

        std::filesystem::path m_path;
        bool m_owns_lock = false;
    };

    [[nodiscard]] std::ifstream open_reader() const;
    bool preconditions_met(const yar::db::metadata& metadata_record, const write_preconditions& preconditions) const;

    void setup_index_structure();
    void populate_indexes();

    db_result<> create_impl(
        std::string_view collection,
        object& document,
        document_revision* revision = nullptr);
    db_result<std::size_t> update_impl(
        std::string_view collection,
        const object& selector,
        const object& updates,
        object& documents,
        write_preconditions preconditions,
        document_revision* revision = nullptr);
    db_result<std::size_t> upsert_impl(
        std::string_view collection,
        const object& selector,
        object& updates,
        object& documents);

    std::string m_db;
    storage_lock m_lock;
    std::flat_map<std::string, yar::db::index> m_index;
    std::fstream m_storage;
    mutable std::shared_mutex m_rwlock;
    bool m_writable = true;
};

} // namespace yar::db
