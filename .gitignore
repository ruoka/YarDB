# IDE and Editor Files
###############################################################################

# Visual Studio Code
.vscode/
!.vscode/settings.json
.vscode-test/
.cursor/*
!.cursor/mcp.json

# Optional local venv for MCP SSE bridge deps
tools/.venv-mcp-sse/
**/__pycache__/
*.py[cod]

# Vim
*.swp
*.swo
*~

