export module yar:index;
import std;
import xson;

using namespace std::string_literals;

namespace yar::db {

using object = xson::object;

using sequence_type = xson::integer_type;

using primary_key_type = sequence_type;

using secondary_index_name = std::string;

using secondary_key_type = xson::primitive;

using position_type = std::streamoff;

// A live document under a secondary key: its _id and the file position of
// that version.
struct posting
{
    primary_key_type id;
    position_type position;
};

// One posting per live _id in ascending _id order, so lists intersect by
// merging and an _id bound is a binary search.
using postings_type = std::vector<posting>;

using primary_index_type = std::map<primary_key_type, position_type>;

// Order integer_type and number_type by numeric value so range queries and
// equality treat JSON doubles and OData integer literals consistently.
using secondary_index_type = std::map<secondary_key_type, postings_type, xson::primitive_less_t>;

using secondary_index_map = std::map<secondary_index_name, secondary_index_type>;

// A bound's keys. The iterators borrow the map; the span owns nothing.
template<class Map>
using key_span = std::ranges::subrange<typename Map::const_iterator, typename Map::const_iterator>;

using secondary_key_span = key_span<secondary_index_type>;

// Join each key's posting list into one sequence of file positions. The
// iterators borrow the map and the vectors; the lists must not change while a
// walk is open.
struct postings_of
{
    const postings_type& operator()(const secondary_index_type::value_type& entry) const
    {
        return entry.second;
    }
};

struct position_of
{
    position_type operator()(const posting& entry) const
    {
        return entry.position;
    }
};

using forward_positions = decltype(
    std::declval<secondary_key_span>()
    | std::views::transform(postings_of{})
    | std::views::join
    | std::views::transform(position_of{}));

// Reverse of the forward join: last key's last posting first. Same order as
// walking keys backward and each posting list from the back.
using reverse_positions = decltype(std::declval<forward_positions>() | std::views::reverse);

// index_view::begin is const, so the cursors are the const join iterators.
using secondary_position_iterator = std::ranges::iterator_t<const forward_positions>;

using reverse_secondary_position_iterator = std::ranges::iterator_t<const reverse_positions>;

inline forward_positions secondary_positions(secondary_key_span keys)
{
    return keys
        | std::views::transform(postings_of{})
        | std::views::join
        | std::views::transform(position_of{});
}

inline reverse_positions reverse_secondary_positions(secondary_key_span keys)
{
    return secondary_positions(keys) | std::views::reverse;
}

// The documents on every term, in _id order or its reverse. A term is one run
// per key of a field's bound. A document has one value per field, so the runs
// of a term never share an _id and the walk merges them. Terms intersect by
// galloping each one to the furthest head. The runs point into the posting
// lists, which must not change while the walk is open.
class posting_stream_iterator
{
public:

    using difference_type = std::ptrdiff_t;
    using value_type = position_type;
    using iterator_concept = std::forward_iterator_tag;

    struct run
    {
        const posting* first = nullptr;
        const posting* last = nullptr;
    };

    using term = std::vector<run>;

    posting_stream_iterator() = default;

    posting_stream_iterator(std::vector<term> terms, bool descending);

    position_type operator*() const
    {
        return m_current->position;
    }

    posting_stream_iterator& operator++();

    posting_stream_iterator operator++(int)
    {
        auto tmp = *this;
        ++*this;
        return tmp;
    }

    friend bool operator==(const posting_stream_iterator& lhs, const posting_stream_iterator& rhs)
    {
        return lhs.m_current == rhs.m_current;
    }

private:

    void align();

    std::vector<term> m_terms;
    bool m_descending = false;
    const posting* m_current = nullptr;
};

class index_iterator
{
public:

    using difference_type = std::ptrdiff_t;
    using value_type = position_type;
    using iterator_concept = std::forward_iterator_tag;

    enum class kind {primary, secondary, reverse_primary, reverse_secondary, posting_stream};

    using primary_iterator = primary_index_type::const_iterator;

    using reverse_primary_iterator = std::reverse_iterator<primary_iterator>;

    index_iterator() :
        m_state{secondary_position_iterator{}},
        m_kind{kind::secondary}
    {}

    index_iterator(const index_iterator&) = default;

    index_iterator(index_iterator&&) = default;

    index_iterator& operator=(const index_iterator&) = default;

    index_iterator& operator=(index_iterator&&) = default;

    index_iterator(primary_iterator current) :
        m_state{current},
        m_kind{kind::primary}
    {}

    index_iterator(secondary_position_iterator current) :
        m_state{current},
        m_kind{kind::secondary}
    {}

    index_iterator(reverse_primary_iterator current) :
        m_state{current},
        m_kind{kind::reverse_primary}
    {}

    index_iterator(reverse_secondary_position_iterator current) :
        m_state{current},
        m_kind{kind::reverse_secondary}
    {}

    index_iterator(posting_stream_iterator current) :
        m_state{std::move(current)},
        m_kind{kind::posting_stream}
    {}

    auto operator*() const -> position_type
    {
        switch(m_kind)
        {
        case kind::primary:
            return std::get<primary_iterator>(m_state)->second;
        case kind::secondary:
            return *std::get<secondary_position_iterator>(m_state);
        case kind::reverse_primary:
            return std::get<reverse_primary_iterator>(m_state)->second;
        case kind::reverse_secondary:
            return *std::get<reverse_secondary_position_iterator>(m_state);
        case kind::posting_stream:
            return *std::get<posting_stream_iterator>(m_state);
        }
        std::unreachable();
    }

    auto& operator++()
    {
        switch(m_kind)
        {
        case kind::primary:
            ++std::get<primary_iterator>(m_state);
            break;
        case kind::secondary:
            ++std::get<secondary_position_iterator>(m_state);
            break;
        case kind::reverse_primary:
            ++std::get<reverse_primary_iterator>(m_state);
            break;
        case kind::reverse_secondary:
            ++std::get<reverse_secondary_position_iterator>(m_state);
            break;
        case kind::posting_stream:
            ++std::get<posting_stream_iterator>(m_state);
            break;
        }
        return *this;
    }

    auto operator++(int)
    {
        auto tmp = *this;
        ++*this;
        return tmp;
    }

    friend bool operator==(const index_iterator& lhs, const index_iterator& rhs)
    {
        if(lhs.m_kind != rhs.m_kind)
            return false;

        switch(lhs.m_kind)
        {
        case kind::primary:
            return std::get<primary_iterator>(lhs.m_state) == std::get<primary_iterator>(rhs.m_state);
        case kind::secondary:
            return std::get<secondary_position_iterator>(lhs.m_state) == std::get<secondary_position_iterator>(rhs.m_state);
        case kind::reverse_primary:
            return std::get<reverse_primary_iterator>(lhs.m_state) == std::get<reverse_primary_iterator>(rhs.m_state);
        case kind::reverse_secondary:
            return std::get<reverse_secondary_position_iterator>(lhs.m_state) == std::get<reverse_secondary_position_iterator>(rhs.m_state);
        case kind::posting_stream:
            return std::get<posting_stream_iterator>(lhs.m_state) == std::get<posting_stream_iterator>(rhs.m_state);
        }
        std::unreachable();
    }

    auto operator!=(const index_iterator& itr) const -> bool
    {
        return not(*this == itr);
    }

private:

    std::variant<
        primary_iterator,
        secondary_position_iterator,
        reverse_primary_iterator,
        reverse_secondary_position_iterator,
        posting_stream_iterator> m_state;

    kind m_kind;
};

// Primary walks store their cursors. A secondary walk owns the join view: join
// iterators hold a pointer to that view, so begin()/end() rebuild them from
// the owned member instead of caching a dangling Parent*. A posting-stream
// walk owns the intersection cursor the same way (terms + heap state).
class index_view : public std::ranges::view_interface<index_view>
{
public:

    template<typename T>
    index_view(T begin, T end, std::optional<std::size_t> known_size = std::nullopt) :
        m_state{cursors{index_iterator{begin}, index_iterator{end}}},
        m_known_size{known_size}
    {}

    index_view(
        forward_positions positions,
        std::size_t drop,
        std::optional<std::size_t> take,
        std::optional<std::size_t> known_size = std::nullopt) :
        m_state{forward_walk{std::move(positions), drop, take}},
        m_known_size{known_size}
    {}

    index_view(reverse_positions positions, std::optional<std::size_t> known_size = std::nullopt) :
        m_state{reverse_walk{std::move(positions)}},
        m_known_size{known_size}
    {}

    index_view(posting_stream_iterator current, std::optional<std::size_t> known_size = std::nullopt) :
        m_state{stream_walk{std::move(current)}},
        m_known_size{known_size}
    {}

    index_iterator begin() const
    {
        return std::visit([](const auto& walk) -> index_iterator
        {
            using walk_type = std::decay_t<decltype(walk)>;
            if constexpr(std::is_same_v<walk_type, cursors>)
                return walk.begin;
            else if constexpr(std::is_same_v<walk_type, forward_walk>)
            {
                auto first = walk.positions.begin();
                auto last = walk.positions.end();
                std::ranges::advance(first, static_cast<std::ptrdiff_t>(walk.drop), last);
                return index_iterator{first};
            }
            else if constexpr(std::is_same_v<walk_type, reverse_walk>)
                return index_iterator{walk.positions.begin()};
            else
                return index_iterator{walk.begin};
        }, m_state);
    }

    index_iterator end() const
    {
        return std::visit([](const auto& walk) -> index_iterator
        {
            using walk_type = std::decay_t<decltype(walk)>;
            if constexpr(std::is_same_v<walk_type, cursors>)
                return walk.end;
            else if constexpr(std::is_same_v<walk_type, forward_walk>)
            {
                auto first = walk.positions.begin();
                auto last = walk.positions.end();
                std::ranges::advance(first, static_cast<std::ptrdiff_t>(walk.drop), last);
                if(walk.take)
                {
                    auto limited = first;
                    std::ranges::advance(limited, static_cast<std::ptrdiff_t>(*walk.take), last);
                    return index_iterator{limited};
                }
                return index_iterator{last};
            }
            else if constexpr(std::is_same_v<walk_type, reverse_walk>)
                return index_iterator{walk.positions.end()};
            else
                return index_iterator{posting_stream_iterator{}};
        }, m_state);
    }

    // sized_range when known_size is set at construction; otherwise walks iterators
    constexpr auto size() const
    {
        if(m_known_size)
            return *m_known_size;

        auto count = std::size_t{0};
        for(auto it = begin(); it != end(); ++it)
            ++count;
        return count;
    }

private:

    struct cursors
    {
        index_iterator begin;
        index_iterator end;
    };

    struct forward_walk
    {
        forward_positions positions;
        std::size_t drop = 0;
        std::optional<std::size_t> take;
    };

    struct reverse_walk
    {
        reverse_positions positions;
    };

    struct stream_walk
    {
        posting_stream_iterator begin;
    };

    std::variant<cursors, forward_walk, reverse_walk, stream_walk> m_state;
    std::optional<std::size_t> m_known_size;
};

class index;

// Inverse of the index edits a write applied. Discard keeps them; apply puts
// the index back. The log stores positions and keys, not a copy of either map.
class index_undo
{
public:

    void apply(index& target);

    void discard() noexcept
    {
        m_ops.clear();
    }

private:

    friend class index;

    struct primary_inserted
    {
        primary_key_type id;
    };

    struct primary_replaced
    {
        primary_key_type id;
        position_type position;
    };

    struct primary_removed
    {
        primary_key_type id;
        position_type position;
    };

    struct secondary_key_added
    {
        secondary_index_name field;
        secondary_key_type key;
    };

    struct secondary_inserted
    {
        secondary_index_name field;
        secondary_key_type key;
        primary_key_type id;
    };

    struct secondary_moved
    {
        secondary_index_name field;
        secondary_key_type key;
        primary_key_type id;
        position_type position;
    };

    struct secondary_removed
    {
        secondary_index_name field;
        secondary_key_type key;
        posting entry;
        bool erased_key;
    };

    struct secondary_map_added
    {
        secondary_index_name field;
    };

    struct unique_added
    {
        secondary_index_name field;
    };

    struct sequence_set
    {
        sequence_type previous;
    };

    using op = std::variant<
        primary_inserted,
        primary_replaced,
        primary_removed,
        secondary_key_added,
        secondary_inserted,
        secondary_moved,
        secondary_removed,
        secondary_map_added,
        unique_added,
        sequence_set>;

    void note_primary_inserted(primary_key_type id)
    {
        m_ops.push_back(primary_inserted{id});
    }

    void note_primary_replaced(primary_key_type id, position_type position)
    {
        m_ops.push_back(primary_replaced{id, position});
    }

    void note_primary_removed(primary_key_type id, position_type position)
    {
        m_ops.push_back(primary_removed{id, position});
    }

    void note_secondary_key(const secondary_index_name& field, const secondary_key_type& key)
    {
        m_ops.push_back(secondary_key_added{field, key});
    }

    void note_secondary_inserted(const secondary_index_name& field, const secondary_key_type& key, primary_key_type id)
    {
        m_ops.push_back(secondary_inserted{field, key, id});
    }

    void note_secondary_moved(
        const secondary_index_name& field,
        const secondary_key_type& key,
        primary_key_type id,
        position_type position)
    {
        m_ops.push_back(secondary_moved{field, key, id, position});
    }

    void note_secondary_removed(
        const secondary_index_name& field,
        const secondary_key_type& key,
        posting entry,
        bool erased_key)
    {
        m_ops.push_back(secondary_removed{field, key, entry, erased_key});
    }

    void note_secondary_map(const secondary_index_name& field)
    {
        m_ops.push_back(secondary_map_added{field});
    }

    void note_unique(const secondary_index_name& field)
    {
        m_ops.push_back(unique_added{field});
    }

    void note_sequence(sequence_type previous)
    {
        m_ops.push_back(sequence_set{previous});
    }

    std::vector<op> m_ops;
};

// A unique secondary value is already held by another live document, or the
// field is present but not a primitive. id is that document when one is known.
struct unique_conflict
{
    std::string field;
    std::optional<primary_key_type> id{};
    bool primitive = true;
};

// Index for fast document lookup by primary key (_id) and secondary keys
// Maintains primary index (by _id) and secondary indexes (by user-defined fields)
class index
{
public:

    index() = default;

    index(const index&) = delete;

    index& operator=(const index&) = delete;

    index(index&&) = default;

    index& operator=(index&&) = default;

    // Add a single secondary index key
    // @param key Field name to index
    void add(const std::string& key, index_undo* undo = nullptr);

    // Add multiple secondary index keys
    // @param keys Field names to index
    void add(std::span<const std::string> keys, index_undo* undo = nullptr);

    // Mark indexed fields unique. Names that are not secondary keys are ignored.
    void add_unique(std::span<const std::string> fields, index_undo* undo = nullptr);

    // Secondary index key names (view into the index; valid while this object lives)
    std::span<const std::string> keys() const;

    // Unique secondary key names (view into the index; valid while this object lives)
    std::span<const std::string> unique_keys() const;

    // Another live row holds a unique value of document, or a unique field is an
    // object or array. A name of fields joined by '+' is that tuple, using the
    // same encoding as its posting list. Missing fields and JSON null do not
    // collide, and neither does the live version of document's own _id. A
    // missing or null part of a compound tuple does not collide.
    std::optional<unique_conflict> conflicts_with(const xson::object& document) const;

    // A unique primitive value is stored on more than one live row. Nulls are ignored.
    std::optional<unique_conflict> duplicate_unique() const;

    // A unique field on this document is an object or array. For a compound
    // name, that is any of its parts.
    std::optional<unique_conflict> non_primitive_unique(const xson::object& document) const;

    // Check if selector uses primary key (_id)
    // @param selector Query selector
    // @return true if selector contains _id field
    bool primary_key(const xson::object& selector) const;

    // Check if selector uses any secondary key
    // @param selector Query selector
    // @return true if selector contains any indexed secondary key field
    bool secondary_key(const xson::object& selector) const;

    // Get index view for querying documents by selector
    // Returns iterator over positions matching the selector. Exact bounds on
    // indexed fields intersect. The walk is in _id order when the selector
    // bounds _id or pages ($top or $skip, or $orderby of _id alone), and in
    // reverse for $desc.
    // @param selector Query selector (can use primary or secondary keys)
    // @return Index view providing iterator over matching document positions
    index_view view(const xson::object& selector) const;

    // Count documents matching the selector.
    // Equality on exactly the fields of a compound key (a key name of fields
    // joined by '+') is the size of that posting list. Exact bounds on _id and
    // on indexed fields are the size of their intersection. Neither reads the
    // file. Any other selector walks the view and applies document.match.
    // @param storage Database file stream for fallback scans
    // @param selector Query selector (ignores $top, $skip, $desc)
    // @return Number of matching documents
    std::size_t count(std::istream& storage, const xson::object& selector) const;

    // Update document and assign _id if missing
    // Increments sequence counter for new _id assignment
    // @param document Document to update (may be modified to add _id)
    // @param undo When set, records the previous sequence
    void update(xson::object& document, index_undo* undo = nullptr);

    // True when a live primary-key entry already exists for id
    bool contains_id(primary_key_type id) const;

    // File position of the live primary-key entry, if present
    std::optional<position_type> position(primary_key_type id) const;

    // Insert document into index with storage position
    // Updates primary key index and all matching secondary key indexes
    // A key holds one posting per _id, in _id order; an _id already there
    // takes the new position
    // @param document Document to index
    // @param position Storage file position where document is stored
    // @param undo When set, records the inverse primary and secondary edits
    void insert(xson::object& document, position_type position, index_undo* undo = nullptr);

    // Index the next version of a live document
    // A key whose value did not change keeps its posting and takes the new
    // position; a changed value moves the posting to the new key
    // @param prior The version the index holds now
    // @param document The version stored at position
    // @param undo When set, records the inverse primary and secondary edits
    void replace(const xson::object& prior, xson::object& document, position_type position, index_undo* undo = nullptr);

    // Erase document from all indexes
    // Removes from primary key index and its postings in secondary indexes
    // @param document Document to remove from index
    // @param undo When set, records the postings to put back
    void erase(const xson::object& document, index_undo* undo = nullptr);

    // Open and reindex read the file in position order. load() appends without
    // ordering, and finish_load() then orders each posting list by _id. An _id
    // stored twice as live keeps the posting of the later version.
    void load(xson::object& document, position_type position);

    void finish_load();

private:

    friend class index_undo;

    // A view, and whether it intersects every exact bound of the selector.
    struct planned_view
    {
        index_view view;
        bool complete;
    };

    planned_view plan(const xson::object& selector) const;

    void place_primary(primary_key_type id, position_type position, index_undo* undo);

    void add_posting(
        const std::string& field,
        const secondary_key_type& key,
        primary_key_type id,
        position_type position,
        index_undo* undo);

    void remove_posting(
        const std::string& field,
        const secondary_key_type& key,
        primary_key_type id,
        index_undo* undo);

    // Equality on exactly the fields named by a compound key, or nullopt when
    // no compound covers the selector.
    std::optional<std::size_t> compound_equality_count(const xson::object& selector) const;

    xson::integer_type m_sequence = 0;

    primary_index_type m_primary_keys;

    secondary_index_map m_secondary_keys;

    // Sorted like the map, so keys() stays a contiguous view.
    std::vector<std::string> m_key_names;

    std::vector<std::string> m_unique_keys;
};

} // namespace yar::db
