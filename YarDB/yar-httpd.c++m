export module yar:httpd;
import :engine;
import :constants;
import :details;
import :odata;
import :mcp;
import std;
import net;
import xson;

// https://www.odata.org/odata-services/

namespace yar::http {

using namespace std::string_literals;
using namespace std::string_view_literals;
using namespace net;
using namespace ::http;  // HTTP constants and types from net::http
using namespace yar::http::details;
using namespace yar::http::odata;

// Header name constants (YarDB-specific)
// Using module-local constants instead of anonymous namespace to avoid TU-local entity exposure warnings
constexpr auto correlation_id_header = "x-correlation-id"sv;

// Cached correlation ID header string (headers API requires std::string)
const auto correlation_id_header_str = std::string{correlation_id_header};

// Collection routes exclude reserved path segments (e.g. /health, /ready, /metrics,
// /sse, /messages). Native MCP claims /sse and /messages/; keep them out of the
// collection matcher so enable_mcp(false) yields 404 instead of treating "sse"
// as a collection name.
inline const auto collection_route = "/(?!health$|ready$|metrics$|sse$|messages$)[a-z][a-z0-9]*"s;
inline const auto collection_route_with_query = "/(?!health$|ready$|metrics$|sse$|messages$)[a-z][a-z0-9]*(\\?.*)?"s;
inline const auto collection_route_with_id = "/(?!health$|ready$|metrics$|sse$|messages$)[a-z][a-z0-9]*/[0-9]+"s;

// Handler type aliases for middleware composition
using handler = ::http::callback_with_headers;
using middleware_factory = ::http::middleware_factory;

// Do not trust client-supplied proxy headers for the default rate-limit key.
inline auto safe_rate_limit_key_extractor(std::string_view, const ::http::headers&)
{
    return "unknown"s;
}

inline auto database_error_response(const yar::db::db_error& error)
{
    if(error.code == yar::db::db_error_code::precondition_failed)
    {
        auto body = xson::object{
            {"error", "Precondition Failed"s},
            {"message", error.message}
        };
        return response_with_headers{
            status_precondition_failed,
            xson::json::stringify(body),
            std::optional<::http::headers>{}};
    }

    if(error.code == yar::db::db_error_code::conflict)
    {
        auto body = xson::object{
            {"error", "Conflict"s},
            {"message", error.message}
        };
        return response_with_headers{
            status_conflict,
            xson::json::stringify(body),
            std::optional<::http::headers>{}};
    }

    auto body = xson::object{
        {"error", "Internal Server Error"s},
        {"message", error.message}
    };
    return response_with_headers{
        status_internal_server_error,
        xson::json::stringify(body),
        std::optional<::http::headers>{}};
}

enum class server_state
{
    stopped,
    starting,
    ready,
    draining,
    failed
};

inline auto server_state_label(server_state state)
{
    switch(state)
    {
        case server_state::stopped: return "stopped"sv;
        case server_state::starting: return "starting"sv;
        case server_state::ready: return "ready"sv;
        case server_state::draining: return "draining"sv;
        case server_state::failed: return "failed"sv;
    }
    return "unknown"sv;
}

inline auto ready_probe_body(server_state state)
{
    return xson::json::stringify(xson::object{
        {"status"s, std::string{server_state_label(state)}}
    }, 0);
}

// Public path classifier for PAT middleware (CLI / tests). Body stays in :details.
export inline bool is_public_api_path(std::string_view uri)
{
    return yar::http::details::is_public_api_path(uri);
}

export class rest_api_server
{
public:
    rest_api_server(
        std::string_view file,
        std::string_view port_or_service,
        std::string_view bind_host = "127.0.0.1"sv) :
        m_file{file},
        m_bind_host{bind_host},
        m_port_or_service{port_or_service},
        m_engine{file}
    {
        // Cap Content-Length before net allocates the body. Middleware alone
        // cannot prevent memory exhaustion from a huge Content-Length header.
        m_server.max_request_body_size(yar::db::max_request_body_size);
        setup_routes();
    }

    void start()
    {
        std::lock_guard<std::mutex> lock{m_start_mutex};
        if(m_listen_thread.joinable())
            return;

        m_state.store(server_state::starting);
        m_listen_thread = std::thread{[this]()
        {
            try
            {
                slog << info("SERVER_START") << "Server starting on " << m_bind_host << ":" << m_port_or_service
                      << std::pair{"addr"sv, m_bind_host}
                      << std::pair{"port"sv, m_port_or_service}
                      << flush;
                m_server.listen(m_bind_host, m_port_or_service, [this]()
                {
                    m_state.store(server_state::ready);
                });
                if(m_state.load() != server_state::draining)
                    m_state.store(server_state::stopped);
            }
            catch(const std::exception& e)
            {
                m_state.store(server_state::failed);
                slog << error("SERVER_START_ERROR") << "Failed to start server: " << e.what()
                      << std::pair{"port"sv, m_port_or_service}
                      << flush;
            }
        }};
    }

    void drain()
    {
        std::lock_guard<std::mutex> lock{m_start_mutex};
        const auto state = m_state.load();
        if(state == server_state::ready or state == server_state::starting)
            m_state.store(server_state::draining);
    }

    void stop()
    {
        std::lock_guard<std::mutex> lock{m_start_mutex};
        const auto state = m_state.load();
        if(state == server_state::ready or state == server_state::starting)
            m_state.store(server_state::draining);
        m_server.stop();
        if(m_listen_thread.joinable())
        {
            try
            {
                m_listen_thread.join();
            }
            catch(const std::system_error&)
            {
            }
        }
        m_state.store(server_state::stopped);
    }

    auto server_lifecycle_state() const
    {
        return m_state.load();
    }

    // For backward compatibility - blocks forever
    void listen()
    {
        m_state.store(server_state::starting);
        try
        {
            m_server.listen(m_bind_host, m_port_or_service, [this]()
            {
                m_state.store(server_state::ready);
            });
            if(m_state.load() != server_state::draining)
                m_state.store(server_state::stopped);
        }
        catch(const std::exception&)
        {
            m_state.store(server_state::failed);
            throw;
        }
    }

    ~rest_api_server()
    {
        stop(); // Stop server and wait for thread to finish
    }

    // Rate limiting configuration.
    // Default key ignores X-Forwarded-For / X-Real-IP — those headers are
    // client-spoofable unless a trusted reverse proxy strips/overwrites them.
    // Pass a custom extractor only when the deployment trusts those headers.
    void configure_rate_limiting(
        std::size_t max_requests = 100,
        std::chrono::seconds window_seconds = std::chrono::seconds{60},
        std::function<std::string(std::string_view request, const ::http::headers&)> key_extractor = {})
    {
        m_rate_limiting_enabled = true;
        m_rate_limit_max_requests = max_requests;
        m_rate_limit_window_seconds = window_seconds;
        if(key_extractor)
            m_rate_limit_key_extractor = std::move(key_extractor);
        else
            m_rate_limit_key_extractor = safe_rate_limit_key_extractor;
    }

    void disable_rate_limiting()
    {
        m_rate_limiting_enabled = false;
        m_rate_limit_max_requests = 100;
        m_rate_limit_window_seconds = std::chrono::seconds{60};
        m_rate_limit_key_extractor = safe_rate_limit_key_extractor;
    }

    // CORS configuration
    void configure_cors(
        std::function<bool(std::string_view origin)> allowed_origin = {},
        std::vector<std::string> allowed_methods = {},
        std::vector<std::string> allowed_headers = {},
        bool allow_credentials = true,
        std::optional<int> max_age = std::nullopt)
    {
        m_cors_enabled = true;
        if(allowed_origin)
            m_cors_allowed_origin = std::move(allowed_origin);
        else
            m_cors_allowed_origin = [](std::string_view) { return true; };
        m_cors_allowed_methods = std::move(allowed_methods);
        m_cors_allowed_headers = std::move(allowed_headers);
        m_cors_allow_credentials = allow_credentials;
        m_cors_max_age = max_age;
    }

    void disable_cors()
    {
        m_cors_enabled = false;
        m_cors_allowed_origin = [](std::string_view) { return true; };
        m_cors_allowed_methods.clear();
        m_cors_allowed_headers.clear();
        m_cors_allow_credentials = true;
        m_cors_max_age = std::nullopt;
    }

    // Authentication configuration.
    // validate_token protects ordinary API routes; validate_admin_token (when set) protects `/_*`
    // maintenance paths. If admin validator is empty, `/_*` falls back to validate_token.
    void configure_authentication(
        std::function<bool(std::string_view path)> is_public_path,
        std::function<bool(std::string_view token)> validate_token,
        std::string_view realm = "YarDB API"sv,
        std::function<bool(std::string_view token)> validate_admin_token = {})
    {
        m_is_public_path = std::move(is_public_path);
        m_validate_token = std::move(validate_token);
        m_validate_admin_token = std::move(validate_admin_token);
        m_auth_realm = std::string{realm};
        m_authentication_enabled = static_cast<bool>(m_validate_token)
            or static_cast<bool>(m_validate_admin_token);
        rebuild_routes();
    }

    void disable_authentication()
    {
        m_authentication_enabled = false;
        m_is_public_path = nullptr;
        m_validate_token = nullptr;
        m_validate_admin_token = nullptr;
        m_auth_realm = "YarDB API"s;
        rebuild_routes();
    }

    // Rebuild routes after middleware configuration changes
    // This should be called after configuring middleware if routes were already set up
    void rebuild_routes()
    {
        setup_routes();
    }

    // Native MCP over HTTP+SSE (`GET /sse`, `POST /messages/?session_id=`).
    // Enabled by default; tools call the engine directly (not the Python bridge).
    void enable_mcp(bool enabled = true)
    {
        m_mcp_enabled = enabled;
        if(enabled)
            attach_mcp();
        else
        {
            // Router callbacks capture raw pointers into m_mcp. Clear them
            // before destroying the object or GET /sse / POST /messages/ UAF.
            detach_mcp_routes();
            m_mcp.reset();
        }
    }

    [[nodiscard]] bool mcp_enabled() const noexcept
    {
        return m_mcp_enabled and static_cast<bool>(m_mcp);
    }

private:

    // Clear SSE takeover and overwrite POST /messages so disabled MCP cannot
    // invoke callbacks that outlive m_mcp (yardb --no-mcp / enable_mcp(false)).
    void detach_mcp_routes()
    {
        // Empty sse callback → has_sse() is false (no event-stream takeover).
        // The "/sse" router key still exists after sse(), so also install a GET
        // 404 — otherwise the server answers 405 Method Not Allowed.
        m_server.sse("/sse"s).gate({}).sse({});
        m_server.get("/sse"s).response(
            "text/plain"sv,
            []([[maybe_unused]] ::http::request_view req,
               [[maybe_unused]] ::http::body_view body,
               [[maybe_unused]] ::http::headers& hdr) -> ::http::response_with_headers
            {
                return ::http::make_error_response(status_not_found, "Not Found"sv);
            });
        m_server.post("/messages/?(\\?.*)?"s).response(
            "text/plain"sv,
            []([[maybe_unused]] ::http::request_view req,
               [[maybe_unused]] ::http::body_view body,
               [[maybe_unused]] ::http::headers& hdr) -> ::http::response_with_headers
            {
                return ::http::make_error_response(status_not_found, "Not Found"sv);
            });
    }

    void attach_mcp()
    {
        m_mcp = yar::mcp::make_mcp_server(m_engine, [this] {
            return std::string{server_state_label(m_state.load())};
        });
        // Allow the configured bind host in addition to localhost defaults.
        auto hosts = ::http::mcp::default_allowed_hosts();
        hosts.push_back(m_bind_host + ":*"s);
        hosts.push_back(m_bind_host);
        auto origins = ::http::mcp::default_allowed_origins();
        origins.push_back("http://"s + m_bind_host + ":*"s);
        m_mcp->allowed_hosts(std::move(hosts))
            .allowed_origins(std::move(origins));

        // MCP tools call the engine directly and bypass REST middleware. When
        // PAT auth is configured, require the same Bearer token on SSE open and
        // every POST /messages/ — otherwise --pat/--admin-pat only protect REST
        // while native MCP stays reachable with a spoofable Host header.
        //
        // When both data and admin PATs are configured, mirror REST role
        // separation on tools/call: admin tools need the admin PAT, data tools
        // need the data PAT. SSE open and non-tools/call JSON-RPC still accept
        // either token so a session can be established.
        if(m_authentication_enabled)
        {
            m_mcp->authorize([this]([[maybe_unused]] ::http::request_view req,
                                    ::http::headers& hdr,
                                    ::http::body_view body)
                -> std::optional<::http::response_with_headers>
            {
                std::string_view authorization{};
                if(hdr.contains("authorization"s))
                    authorization = hdr["authorization"s];

                const auto data_ok = m_validate_token and not authorization.empty()
                    and m_validate_token(authorization);
                const auto admin_ok = m_validate_admin_token and not authorization.empty()
                    and m_validate_admin_token(authorization);

                if(not data_ok and not admin_ok)
                {
                    auto error_headers = ::http::headers{};
                    error_headers.set("www-authenticate"s, "Basic realm=\""s + m_auth_realm + "\""s);
                    return ::http::make_error_response(
                        status_unauthorized, "Unauthorized"sv, std::make_optional(error_headers));
                }

                // Dual-PAT role separation only applies when both validators exist
                // and the POST carries a tools/call body (SSE open has empty body).
                //
                // Parse method/name with the same helpers as http::mcp::handle_json_rpc.
                // Those helpers fail closed on duplicate depth-1 keys (net#57). A last-wins
                // app parser could still disagree; reject unparseable method/name here so
                // authorize cannot allow a body that dispatch will not uniquely interpret.
                if(m_validate_token and m_validate_admin_token and not body.empty())
                {
                    using ::http::mcp::detail::json_object_field;
                    using ::http::mcp::detail::json_string_field;

                    const auto method = json_string_field(body, "method"sv);
                    if(not method or method->empty())
                    {
                        auto error_headers = ::http::headers{};
                        error_headers.set(
                            "www-authenticate"s, "Basic realm=\""s + m_auth_realm + "\""s);
                        return ::http::make_error_response(
                            status_unauthorized,
                            "Unauthorized"sv,
                            std::make_optional(error_headers));
                    }
                    if(*method == "tools/call"sv)
                    {
                        const auto params = json_object_field(body, "params"sv).value_or("{}"sv);
                        const auto tool_name = json_string_field(params, "name"sv);
                        // Fail closed: unparseable tools/call must not bypass roles.
                        if(not tool_name or tool_name->empty())
                        {
                            auto error_headers = ::http::headers{};
                            error_headers.set(
                                "www-authenticate"s, "Basic realm=\""s + m_auth_realm + "\""s);
                            return ::http::make_error_response(
                                status_unauthorized,
                                "Unauthorized"sv,
                                std::make_optional(error_headers));
                        }

                        const auto needs_admin = is_mcp_admin_tool(*tool_name);
                        const auto allowed = needs_admin ? admin_ok : data_ok;
                        if(not allowed)
                        {
                            auto error_headers = ::http::headers{};
                            error_headers.set(
                                "www-authenticate"s, "Basic realm=\""s + m_auth_realm + "\""s);
                            return ::http::make_error_response(
                                status_unauthorized,
                                "Unauthorized"sv,
                                std::make_optional(error_headers));
                        }
                    }
                }

                return std::nullopt;
            });
        }

        m_mcp->attach(m_server, "/sse");
    }


    // Middleware: Correlation ID logging - extracts and logs correlation ID for all requests
    middleware_factory correlation_logging_middleware(std::string_view method, std::string_view log_event) const
    {
        return [method = std::string{method}, log_event = std::string{log_event}](handler next)
        {
            return [method, log_event, next = std::move(next)](auto req, auto body, auto hdr) mutable
            {
                const auto correlation_id = hdr[correlation_id_header_str];
                slog << debug(log_event) << method << " " << req << " <- " << body
                      << std::pair{"method", method}
                      << std::pair{"uri"sv, req}
                      << std::pair{"body_size", body.size()}
                      << std::pair{"correlation_id", correlation_id}
                          << flush;

                auto [status, content, headers] = next(req, body, hdr);

                // Log response with correlation ID
                slog << info("HTTP_RESPONSE") << "Response: " << status
                      << std::pair{"method", method}
                      << std::pair{"uri"sv, req}
                      << std::pair{"status", status}
                      << std::pair{"content_length", content.size()}
                      << std::pair{"correlation_id", correlation_id}
                      << flush;

                return response_with_headers{status, content, headers};
            };
        };
    }

    // Middleware: Accept header validation - checks Accept header before processing
    // YarDB-specific version that returns JSON error responses
    // Generic version available in ::http::accept_validation_middleware()
    middleware_factory accept_validation_middleware(bool requires_headers = false) const
    {
        return [requires_headers](handler next)
        {
            return [requires_headers, next = std::move(next)](auto req, auto body, auto hdr) mutable
            {
                if(not accepts_json(hdr))
                {
                    if(requires_headers)
                        return not_acceptable_response_with_headers();
                    else
                    {
                        auto [status, content] = not_acceptable_response();
                        return response_with_headers{status, content, std::optional<::http::headers>{}};
                    }
                }
                return next(req, body, hdr);
            };
        };
    }

    // Middleware: Error handling wrapper - wraps handlers in try-catch with correlation ID logging
    middleware_factory error_handling_middleware(std::string_view method, std::string_view error_event) const
    {
        return [method = std::string{method}, error_event = std::string{error_event}](handler next)
        {
            return [method, error_event, next = std::move(next)](auto req, auto body, auto hdr) mutable
            {
                try
                {
                    return next(req, body, hdr);
                }
                catch(const std::invalid_argument& e)
                {
                    // Client error - invalid input
                    const auto correlation_id = hdr[correlation_id_header_str];
                    slog << error(error_event) << "Invalid argument: " << e.what()
                          << std::pair{"method", method}
                          << std::pair{"uri"sv, req}
                          << std::pair{"status", status_bad_request}
                          << std::pair{"correlation_id", correlation_id}
                          << flush;
                            auto error = xson::object{
                                {"error", "Bad Request"s},
                        {"message", std::string{e.what()}}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
                catch(const std::out_of_range& e)
                {
                    // Client error - value out of range
                    const auto correlation_id = hdr[correlation_id_header_str];
                    slog << error(error_event) << "Out of range: " << e.what()
                          << std::pair{"method", method}
                          << std::pair{"uri"sv, req}
                          << std::pair{"status", status_bad_request}
                          << std::pair{"correlation_id", correlation_id}
                          << flush;
                    auto error = xson::object{
                        {"error", "Bad Request"s},
                        {"message", std::string{e.what()}}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
                catch(const std::runtime_error& e)
                {
                    // Client error - typically JSON parsing errors or other runtime validation errors
                    const auto correlation_id = hdr[correlation_id_header_str];
                    slog << error(error_event) << "Runtime error: " << e.what()
                          << std::pair{"method", method}
                          << std::pair{"uri"sv, req}
                          << std::pair{"status", status_bad_request}
                          << std::pair{"correlation_id", correlation_id}
                          << flush;
                    auto error = xson::object{
                        {"error", "Bad Request"s},
                        {"message", std::string{e.what()}}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
                catch(const std::exception& e)
                {
                    // Server error - unexpected exception
                    const auto correlation_id = hdr[correlation_id_header_str];
                    slog << error(error_event) << "Internal error: " << e.what()
                          << std::pair{"method", method}
                          << std::pair{"uri"sv, req}
                          << std::pair{"status", status_internal_server_error}
                          << std::pair{"correlation_id", correlation_id}
                          << flush;
                    auto error = xson::object{
                        {"error", "Internal Server Error"s},
                        {"message", "An unexpected error occurred"s}
                    };
                    return response_with_headers{status_internal_server_error, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
            };
        };
    }

    // Rate limiting middleware - optional, uses ::http::rate_limiting_middleware
    // Returns middleware factory if rate limiting is enabled, otherwise returns empty optional
    std::optional<middleware_factory> rate_limiting_middleware() const
    {
        if(not m_rate_limiting_enabled)
            return std::nullopt;
        
        return ::http::middleware::rate_limiting_middleware(
            m_rate_limit_max_requests,
            m_rate_limit_window_seconds,
            m_rate_limit_key_extractor
        );
    }

    // CORS middleware - optional, uses ::http::cors_middleware
    // Returns middleware factory if CORS is enabled, otherwise returns empty optional
    std::optional<middleware_factory> cors_middleware() const
    {
        if(not m_cors_enabled)
            return std::nullopt;
        
        return ::http::middleware::cors_middleware(
            m_cors_allowed_origin,
            m_cors_allowed_methods,
            m_cors_allowed_headers,
            m_cors_allow_credentials,
            m_cors_max_age
        );
    }

    // Path-aware PAT middleware: public paths skip auth; `/_*` uses admin validator when set.
    std::optional<middleware_factory> authentication_middleware() const
    {
        if(not m_authentication_enabled)
            return std::nullopt;

        return [is_public_path = m_is_public_path,
                validate_token = m_validate_token,
                validate_admin_token = m_validate_admin_token,
                realm = m_auth_realm](handler next)
        {
            return [is_public_path, validate_token, validate_admin_token, realm, next = std::move(next)](
                       auto req, auto body, auto hdr) mutable
            {
                if(is_public_path and is_public_path(req))
                    return next(req, body, hdr);

                const auto admin_path = is_admin_api_path(req);
                const auto& validator = (admin_path and validate_admin_token)
                    ? validate_admin_token
                    : validate_token;

                if(not validator)
                    return next(req, body, hdr);

                std::string_view authorization{};
                if(hdr.contains("authorization"s))
                    authorization = hdr["authorization"s];

                if(authorization.empty() or not validator(authorization))
                {
                    auto error_headers = ::http::headers{};
                    error_headers.set("www-authenticate"s, "Basic realm=\""s + realm + "\""s);
                    return make_error_response(
                        status_unauthorized, "Unauthorized"sv, std::make_optional(error_headers));
                }

                return next(req, body, hdr);
            };
        };
    }

    // Build standard middleware chain for handlers
    // Vector order is inner→outer for wrap() (reversed when composing). Metrics is near the
    // outside so GET /metrics short-circuits before Accept/auth; scrapes are not counted.
    // Logical request flow: error handling → metrics → accept → … → handler
    std::vector<middleware_factory> build_middleware_chain(std::string_view method, std::string_view log_event, std::string_view error_event, bool requires_headers = false) const
    {
        // Count: correlation ID, body size, correlation logging, accept validation, metrics, error handling, optionally rate limiting, CORS, authentication
        constexpr std::size_t base_middleware_count = 6;
        const std::size_t middleware_count = base_middleware_count + 
            (m_rate_limiting_enabled ? 1 : 0) + 
            (m_cors_enabled ? 1 : 0) + 
            (m_authentication_enabled ? 1 : 0);
        
        auto middlewares = std::vector<middleware_factory>{};
        middlewares.reserve(middleware_count);
        
        // 1. Rate limiting (innermost optional — reject early before processing)
        if(m_rate_limiting_enabled)
        {
            if(auto rate_mw = rate_limiting_middleware())
                middlewares.emplace_back(*rate_mw);
        }
        
        // 2. CORS
        if(m_cors_enabled)
        {
            if(auto cors_mw = cors_middleware())
                middlewares.emplace_back(*cors_mw);
        }
        
        // 3. Correlation ID
        middlewares.emplace_back(::http::middleware::correlation_id_middleware());
        
        // 4. Authentication
        if(m_authentication_enabled)
        {
            if(auto auth_mw = authentication_middleware())
                middlewares.emplace_back(*auth_mw);
        }
        
        // 5. Body size validation
        middlewares.emplace_back(::http::middleware::body_size_validation_middleware(yar::db::max_request_body_size));

        // 6. Correlation logging
        middlewares.emplace_back(correlation_logging_middleware(method, log_event));
        
        // 7. Accept validation
        middlewares.emplace_back(accept_validation_middleware(requires_headers));

        // 8. Prometheus metrics (outer vs accept/auth so scrapers need not send Accept: json)
        middlewares.emplace_back(::http::middleware::metrics_middleware());
        
        // 9. Error handling (outermost)
        middlewares.emplace_back(error_handling_middleware(method, error_event));
        
        return middlewares;
    }

    void setup_routes()
    {
        // Create - Refactored to use middleware pattern and helper functions
        auto create_handler = [this](::http::request_view request, ::http::body_view body, ::http::headers& headers)
        {
            // Validate body is not empty
            if(body.empty())
            {
                return make_error_response_with_headers(status_bad_request, "Bad Request"s, "Request body is required"s);
            }
            
            const auto ctx = handler_context{request, m_engine};
            auto document = xson::json::parse(body);
            const auto created = m_engine.create(ctx.collection, document);
            if(not created)
                return database_error_response(created.error());
            
            // Add Location header pointing to the newly created resource
            auto response_headers = ::http::headers{};
            const auto id = static_cast<xson::integer_type>(document["_id"s]);
            response_headers.set("location"s, "/"s + ctx.collection + "/"s + std::to_string(id));
            
            // Add OData metadata if requested
            yar::http::odata::add_metadata_if_requested(document, headers, ctx.collection, id);
            
            return response_with_headers{status_created, xson::json::stringify(document), std::make_optional(response_headers)};
        };

        auto create_middlewares = build_middleware_chain(method_post, "POST_DOCUMENT"sv, "CREATE_ERROR"sv, true);
        m_server.post(collection_route).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(create_handler, create_middlewares));

        // HEAD / - Removed, will use GET fallback

        // List all collections - Refactored to use middleware pattern
        auto list_collections_handler = [this]([[maybe_unused]] ::http::request_view request, [[maybe_unused]] ::http::body_view body, ::http::headers& headers)
        {
            auto response = xson::object{"collections", m_engine.collections()};

            // Add OData metadata if requested
            const auto metadata_level = yar::http::odata::parse_metadata_level(headers);
            if(metadata_level != yar::http::odata::metadata_level::none)
            {
                response["@odata.context"s] = "/$metadata#Collections"s;
            }

            return response_with_headers{status_ok, xson::json::stringify(response), std::optional<::http::headers>{}};
        };

        auto list_middlewares = build_middleware_chain(method_get, "LIST_COLLECTIONS"sv, "LIST_COLLECTIONS_ERROR"sv, false);
        m_server.get("/"s).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(list_collections_handler, list_middlewares));

        auto health_handler = []([[maybe_unused]] ::http::request_view request,
                                 [[maybe_unused]] ::http::body_view body,
                                 [[maybe_unused]] ::http::headers& headers)
        {
            return response_with_headers{
                status_ok,
                "{}"s,
                std::optional<::http::headers>{}
            };
        };

        auto ready_handler = [this]([[maybe_unused]] ::http::request_view request,
                                    [[maybe_unused]] ::http::body_view body,
                                    [[maybe_unused]] ::http::headers& headers)
        {
            const auto state = m_state.load();
            if(state == server_state::ready)
            {
                return response_with_headers{
                    status_ok,
                    "{}"s,
                    std::optional<::http::headers>{}
                };
            }

            return response_with_headers{
                status_service_unavailable,
                ready_probe_body(state),
                std::optional<::http::headers>{}
            };
        };

        auto health_middlewares = build_middleware_chain(method_get, "HEALTH_CHECK"sv, "HEALTH_CHECK_ERROR"sv, false);
        m_server.get("/health"s).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(health_handler, health_middlewares));

        auto ready_middlewares = build_middleware_chain(method_get, "READY_CHECK"sv, "READY_CHECK_ERROR"sv, false);
        m_server.get("/ready"s).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(ready_handler, ready_middlewares));

        // GET /metrics — Prometheus scrape (short-circuited by metrics_middleware; handler is unused)
        auto metrics_handler = []([[maybe_unused]] ::http::request_view request,
                                  [[maybe_unused]] ::http::body_view body,
                                  [[maybe_unused]] ::http::headers& headers)
        {
            return response_with_headers{status_ok, ""s, std::optional<::http::headers>{}};
        };
        auto metrics_middlewares = build_middleware_chain(method_get, "METRICS_SCRAPE"sv, "METRICS_SCRAPE_ERROR"sv, false);
        m_server.get("/metrics"s).response_with_headers(
            "text/plain"sv,
            ::http::middleware::wrap(metrics_handler, metrics_middlewares));

        // GET /$metadata - OData 4.01 JSON CSDL metadata endpoint
        auto metadata_handler = [this]([[maybe_unused]] ::http::request_view request, 
                                       [[maybe_unused]] ::http::body_view body, 
                                       [[maybe_unused]] ::http::headers& headers)
        {
            
            // Generate metadata from existing collections
            auto metadata = yar::http::odata::generate_metadata(m_engine);
            
            // Return as JSON
            return response_with_headers{
                status_ok, 
                xson::json::stringify(metadata), 
                std::optional<::http::headers>{}
            };
        };

        auto metadata_middlewares = build_middleware_chain(
            method_get, 
            "GET_METADATA"sv, 
            "GET_METADATA_ERROR"sv, 
            false
        );
        
        // Route pattern: $ needs to be escaped in regex, use \\$ to match literal $
        m_server.get("/\\$metadata"s).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(metadata_handler, metadata_middlewares));

        // Read _id - Refactored to use middleware pattern and helper functions
        // Route pattern /[a-z][a-z0-9]*/[0-9]+ ensures uri.path[2] is numeric
        auto get_document_handler = [this](::http::request_view request, [[maybe_unused]] ::http::body_view body, ::http::headers& headers)
        {
            const auto ctx = handler_context{request, m_engine};
            const auto id = utils::stoll(ctx.uri.path[2]); // Regex ensures numeric format
            auto documents = xson::object{};
            const auto selector = xson::object{"_id", id};
            auto revision = yar::db::document_revision{};

            // Body + revision must be captured under one engine lock. A separate
            // metadata_position/timestamp after read can observe a newer write and
            // emit a stale body with a fresh ETag, defeating If-Match.
            const auto found = m_engine.read(ctx.collection, selector, documents, revision);

            // Check if document was found
            if(not found or documents.get<xson::object::array>().empty())
            {
                auto error = xson::object{
                    {"error", "Not Found"s},
                    {"message", "Document not found"s},
                    {"collection", ctx.collection},
                    {"id", id}
                };
                return response_with_headers{status_not_found, xson::json::stringify(error), std::optional<::http::headers>{}};
            }

            // Return single object (first element of array)
            auto document = documents.get<xson::object::array>()[0];
            
            // Add OData metadata if requested
            yar::http::odata::add_metadata_if_requested(document, headers, ctx.collection, id);
            
            auto response_headers = ::http::headers{};
            
            // Generate ETag from the revision that produced this body
            if(revision.position.has_value())
            {
                const auto etag = generate_etag(revision.position.value());
                response_headers.set("etag"s, etag);
                
                // Check If-None-Match conditional request (for GET/HEAD)
                const auto none_match_check = check_if_none_match(headers, etag);
                if(none_match_check.has_value() and not none_match_check.value())
                {
                    // ETag matches - resource not modified, return 304 Not Modified
                    if(revision.timestamp.has_value())
                    {
                        const auto last_modified = format_http_date(revision.timestamp.value());
                        response_headers.set("last-modified"s, last_modified);
                    }
                    return response_with_headers{status_not_modified, ""s, std::make_optional(response_headers)};
                }
            }
            
            if(revision.timestamp.has_value())
            {
                const auto last_modified = format_http_date(revision.timestamp.value());
                response_headers.set("last-modified"s, last_modified);
                
                // Check If-Modified-Since conditional request
                const auto modified_check = check_if_modified_since(headers, revision.timestamp.value());
                if(modified_check.has_value() and not modified_check.value())
                {
                    // Document not modified since client's date - return 304 Not Modified
                    return response_with_headers{status_not_modified, ""s, std::make_optional(response_headers)};
                }
            }
            
            return response_with_headers{::http::status_ok, xson::json::stringify(document), std::make_optional(response_headers)};
        };

        auto get_document_middlewares = build_middleware_chain(method_get, "GET_DOCUMENT"sv, "GET_DOCUMENT_ERROR"sv, true);
        m_server.get(collection_route_with_id).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(get_document_handler, get_document_middlewares));

        // Read collection with OData query parameters - Refactored to use middleware pattern
        // Route pattern allows optional query string: /[a-z][a-z0-9]*(\?.*)?
        // Note: Collection names must start with a letter, but can contain digits
        auto get_collection_handler = [this](::http::request_view request, [[maybe_unused]] ::http::body_view body, ::http::headers& headers)
        {
            const auto uri = ::http::uri{request};
            auto document = xson::object{};
            auto selector = xson::object{};
            
            // Parse OData query parameters
            auto params = parse_query_params(uri);

            // Handle $apply (filter/compute/groupby pipeline) before $count.
            // `$apply=…&$count=true` must not short-circuit to a bare document count.
            if(params.contains("$apply"s))
            {
                const auto incompatible = std::array{
                    "$top"sv, "$skip"sv, "$orderby"sv, "$select"sv, "$expand"sv,
                    "$count"sv, "$compute"sv};
                for(const auto name : incompatible)
                {
                    if(params.contains(std::string{name}))
                    {
                        auto error = xson::object{
                            {"error", "Unprocessable Entity"s},
                            {"message", "$apply cannot be combined with "s + std::string{name}
                                + (name == "$compute"sv
                                    ? " (use compute(...) inside $apply)"s
                                    : ""s)}
                        };
                        return response_with_headers{
                            status_unprocessable_entity,
                            xson::json::stringify(error),
                            std::optional<::http::headers>{}};
                    }
                }

                try
                {
                    const auto collection_name = validate_collection_name(uri.path[1]);
                    const auto pipeline = yar::http::odata::parse_apply(params["$apply"s]);
                    auto filter = std::optional<yar::http::odata::parsed_filter>{};
                    if(params.contains("$filter"s))
                        filter = yar::http::odata::parse_filter(params["$filter"s]);
                    const auto document = yar::http::odata::read_with_apply(
                        m_engine, collection_name, pipeline, filter);
                    return response_with_headers{
                        ::http::status_ok,
                        xson::json::stringify(document),
                        std::optional<::http::headers>{}};
                }
                catch(const std::invalid_argument& e)
                {
                    auto error = xson::object{
                        {"error", "Unprocessable Entity"s},
                        {"message", std::string{e.what()}}
                    };
                    return response_with_headers{
                        status_unprocessable_entity,
                        xson::json::stringify(error),
                        std::optional<::http::headers>{}};
                }
            }
            
            // Handle $count (OData: $count=true) - return count only
            if(params.contains("$count"s) and params["$count"s] == "true"s)
            {
                // Build selector for counting (without $top/$skip to get full count)
                auto count_selector = xson::object{};
                const auto collection_name = validate_collection_name(uri.path[1]);
                // $compute runs before $filter (OData). Counting a computed alias such as
                // `$count=true&$compute=Price mul Qty as LineTotal&$filter=LineTotal gt 10`
                // must project first; the index/count path only sees stored fields.
                if(params.contains("$compute"s))
                {
                    try
                    {
                        auto documents = xson::object{};
                        m_engine.read(collection_name, count_selector, documents);
                        const auto clauses = yar::http::odata::parse_compute(params["$compute"s]);
                        documents = yar::http::odata::apply_compute(documents, clauses);
                        if(params.contains("$filter"s))
                        {
                            const auto parsed_filter = yar::http::odata::parse_filter(params["$filter"s]);
                            documents = yar::http::odata::filter_documents_by_parsed(
                                documents, parsed_filter);
                        }
                        const auto count = documents.is_array()
                            ? documents.get<xson::object::array>().size()
                            : std::size_t{0};
                        return response_with_headers{
                            ::http::status_ok,
                            std::to_string(static_cast<long long>(count)),
                            std::optional<::http::headers>{}};
                    }
                    catch(const std::invalid_argument& e)
                    {
                        auto error = xson::object{
                            {"error", "Unprocessable Entity"s},
                            {"message", std::string{e.what()}}
                        };
                        return response_with_headers{
                            status_unprocessable_entity,
                            xson::json::stringify(error),
                            std::optional<::http::headers>{}};
                    }
                }
                const auto count = [&]()
                {
                    if(params.contains("$filter"s))
                    {
                        const auto parsed_filter = yar::http::odata::parse_filter(params["$filter"s]);
                        return yar::http::odata::count_with_parsed_filter(m_engine, collection_name, count_selector, parsed_filter);
                    }

                    return m_engine.count(collection_name, count_selector);
                }();
                
                // Return count as JSON number (OData spec: $count=true returns just the number)
                // JSON numbers are valid as plain strings (e.g., "42" is valid JSON)
                return response_with_headers{::http::status_ok, std::to_string(static_cast<long long>(count)), std::optional<::http::headers>{}};
            }

            // Handle $top (OData: $top=n)
            if(params.contains("$top"s))
            {
                try
                {
                    const auto top_value = yar::http::odata::parse_top(params["$top"s]);
                    selector["$top"s] = top_value;
                }
                catch(const std::invalid_argument& e)
                {
                    // Return 422 for OData query parameter validation errors
                    auto error = xson::object{
                        {"error", "Unprocessable Entity"s},
                        {"message", std::string{e.what()}}
                    };
                    return response_with_headers{status_unprocessable_entity, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
            }
            
            // Handle $skip (OData: $skip=n)
            if(params.contains("$skip"s))
            {
                try
                {
                    const auto skip_value = yar::http::odata::parse_skip(params["$skip"s]);
                    selector["$skip"s] = skip_value;
                }
                catch(const std::invalid_argument& e)
                {
                    // Return 422 for OData query parameter validation errors
                    auto error = xson::object{
                        {"error", "Unprocessable Entity"s},
                        {"message", std::string{e.what()}}
                    };
                    return response_with_headers{status_unprocessable_entity, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
            }
            
            // Handle $orderby (OData: $orderby=field desc or $orderby=field asc)
            if(params.contains("$orderby"s))
            {
                try
                {
                    const auto orderby_result = yar::http::odata::parse_orderby(params["$orderby"s]);
                    selector["$orderby"s] = orderby_result.field_name;
                    if(orderby_result.descending)
                    {
                        selector["$desc"s] = true;
                    }
                }
                catch(const std::invalid_argument& e)
                {
                    // Return 422 for OData query parameter validation errors
                    auto error = xson::object{
                        {"error", "Unprocessable Entity"s},
                        {"message", std::string{e.what()}}
                    };
                    return response_with_headers{status_unprocessable_entity, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
            }
            const auto collection_name = validate_collection_name(uri.path[1]);

            // $compute must run before $filter/$orderby/$top/$skip (OData evaluation
            // order). Strip paging from the engine selector and defer $filter when
            // compute is present so aliases like LineTotal are visible to $filter.
            auto compute_paging = std::optional<yar::http::odata::query_paging>{};
            auto deferred_filter = std::optional<yar::http::odata::parsed_filter>{};
            if(params.contains("$compute"s))
            {
                compute_paging = yar::http::odata::extract_and_strip_paging(selector);
            }

            if(params.contains("$filter"s))
            {
                const auto parsed_filter = yar::http::odata::parse_filter(params["$filter"s]);
                if(params.contains("$compute"s))
                {
                    deferred_filter = parsed_filter;
                    m_engine.read(collection_name, selector, document);
                }
                else
                {
                    document = yar::http::odata::read_with_parsed_filter(
                        m_engine, collection_name, selector, parsed_filter);
                }
            }
            else
            {
                m_engine.read(collection_name, selector, document);
            }

            // OData order with $compute: compute → filter → orderby/skip/top →
            // $expand → $select. Expanding before a deferred $filter made
            // navigation properties visible to $filter (unlike the non-compute
            // path, which filters then expands), so e.g.
            // `$expand=customer&$filter=customer/name eq 'Acme'&$compute=…`
            // over-matched ref-only documents. Keep expand before $select so
            // `*_id` reference fields are still present for nesting.
            if(params.contains("$compute"s))
            {
                try
                {
                    const auto clauses = yar::http::odata::parse_compute(params["$compute"s]);
                    document = yar::http::odata::apply_compute(document, clauses);
                    if(deferred_filter)
                    {
                        document = yar::http::odata::filter_documents_by_parsed(
                            document, *deferred_filter);
                    }
                    if(compute_paging)
                    {
                        if(not compute_paging->orderby_field.empty())
                        {
                            yar::db::apply_orderby(
                                document,
                                compute_paging->orderby_field,
                                compute_paging->descending);
                        }
                        document = yar::http::odata::apply_top_skip(
                            document, compute_paging->skip, compute_paging->top);
                    }
                }
                catch(const std::invalid_argument& e)
                {
                    auto error = xson::object{
                        {"error", "Unprocessable Entity"s},
                        {"message", std::string{e.what()}}
                    };
                    return response_with_headers{
                        status_unprocessable_entity,
                        xson::json::stringify(error),
                        std::optional<::http::headers>{}};
                }
            }

            if(params.contains("$expand"s))
            {
                document = yar::http::odata::apply_expand(document, params["$expand"s], collection_name, m_engine);
            }

            if(params.contains("$select"s))
            {
                document = yar::http::odata::apply_select(document, params["$select"s]);
            }
            
            // Add OData metadata if requested
            const auto metadata_level = yar::http::odata::parse_metadata_level(headers);
            if(metadata_level != yar::http::odata::metadata_level::none)
            {
                if(document.is_array())
                {
                    document = yar::http::odata::add_metadata_to_array(document, metadata_level, collection_name);
                }
                else if(document.has("_id"s))
                {
                    // Single object - add metadata directly
                    const auto doc_id = static_cast<xson::integer_type>(document["_id"s]);
                    document = yar::http::odata::add_metadata(document, metadata_level, collection_name, doc_id);
                }
            }
            
            return response_with_headers{::http::status_ok, xson::json::stringify(document), std::optional<::http::headers>{}};
        };

        auto get_collection_middlewares = build_middleware_chain(method_get, "GET_COLLECTION"sv, "GET_COLLECTION_ERROR"sv, false);
        m_server.get(collection_route_with_query).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(get_collection_handler, get_collection_middlewares));


        // PUT /_db/{collection_name} - Add/update secondary indexes for a collection - Refactored to use middleware pattern
        auto put_index_handler = [this](::http::request_view request, ::http::body_view body, ::http::headers& headers)
        {
            // Validate body is not empty
            if(body.empty())
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "Request body is required"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            const auto uri = ::http::uri{request};
            auto request_body = xson::json::parse(body);
            
            // Validate request body has "keys" field
            if(not request_body.has("keys"s))
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "Request body must contain 'keys' field with array of field names"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            // Extract and validate keys
            auto keys_value = request_body["keys"s];
            if(not keys_value.is_array())
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "'keys' must be an array of field names"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            auto keys_array = keys_value.get<xson::object::array>();
            if(keys_array.empty())
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "'keys' array cannot be empty"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            // Convert keys array to vector of strings
            auto keys = std::vector<std::string>{};
            for(const auto& key : keys_array)
            {
                if(not key.is_string())
                {
                    auto error = xson::object{
                        {"error", "Bad Request"s},
                        {"message", "All keys must be strings"s}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
                
                auto key_str = static_cast<std::string>(key);
                // Validate key name (basic validation)
                if(key_str.empty() or key_str.size() > yar::db::max_field_name_length)
                {
                    auto error = xson::object{
                        {"error", "Bad Request"s},
                        {"message", "Key name is invalid or too long (max "s + std::to_string(yar::db::max_field_name_length) + " chars)"}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
                
                // Don't allow reserved field names
                if(key_str == yar::db::reserved_field_id)
                {
                    auto error = xson::object{
                        {"error", "Bad Request"s},
                        {"message", "Cannot index reserved field: "s + key_str}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
                
                keys.push_back(key_str);
            }
            
            // Extract collection name from path (e.g., /_db/users -> users)
            const auto collection_name = validate_collection_name(uri.path[2]); // path[0] = "", path[1] = "_db", path[2] = collection_name
            
            // Switch to target collection. index() populates new secondaries
            // under the same lock; reindex() still rebuilds/heals from storage.
            const auto indexed = m_engine.index(collection_name, keys);
            if(not indexed)
                return database_error_response(indexed.error());
            
            const auto reindexed = m_engine.reindex();
            if(not reindexed)
                return database_error_response(reindexed.error());
            
            // Get the updated _db document to return
            auto selector = xson::object{"collection"s, collection_name};
            auto db_documents = xson::object{};
            auto found = m_engine.read("_db"s, selector, db_documents);
            
            if(not found or db_documents.get<xson::object::array>().empty())
            {
                // This shouldn't happen, but handle it gracefully
                auto error = xson::object{
                    {"error", "Internal Server Error"s},
                    {"message", "Failed to retrieve index configuration after update"s}
                };
                return response_with_headers{status_internal_server_error, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            auto result_document = db_documents.get<xson::object::array>()[0];
            
            // Add OData metadata if requested
            const auto metadata_level = yar::http::odata::parse_metadata_level(headers);
            if(metadata_level != yar::http::odata::metadata_level::none)
            {
                const auto doc_id = static_cast<xson::integer_type>(result_document["_id"s]);
                result_document = yar::http::odata::add_metadata(result_document, metadata_level, "_db"s, doc_id);
            }
            
            // Determine if this was a create (201) or update (200)
            // We can check if the document was just created by checking if it's the first one
            // For simplicity, we'll return 200 OK (the index() method uses upsert)
            auto response_headers = ::http::headers{};
            response_headers.set("location"s, "/_db/"s + collection_name);
            
            return response_with_headers{::http::status_ok, xson::json::stringify(result_document), std::make_optional(response_headers)};
        };

        auto put_index_middlewares = build_middleware_chain(method_put, "PUT_INDEX"sv, "PUT_INDEX_ERROR"sv, true);
        m_server.put("/_db/[a-z][a-z0-9]*"s).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(put_index_handler, put_index_middlewares));

        // PATCH /_db/{collection_name} - Add secondary indexes incrementally (merge with existing) - Refactored to use middleware pattern
        auto patch_index_handler = [this](::http::request_view request, ::http::body_view body, ::http::headers& headers)
        {
            // Validate body is not empty
            if(body.empty())
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "Request body is required"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            const auto uri = ::http::uri{request};
            auto request_body = xson::json::parse(body);
            
            // Validate request body has "keys" field
            if(not request_body.has("keys"s))
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "Request body must contain 'keys' field with array of field names"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            // Extract and validate keys
            const auto keys_value = request_body["keys"s];
            if(not keys_value.is_array())
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "'keys' must be an array of field names"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            const auto keys_array = keys_value.get<xson::object::array>();
            if(keys_array.empty())
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "'keys' array cannot be empty"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            // Extract collection name from path
            const auto collection_name = validate_collection_name(uri.path[2]);
            
            // Get existing keys from _db collection (if any)
            auto selector = xson::object{"collection"s, collection_name};
            auto existing_docs = xson::object{};
            auto has_existing = m_engine.read("_db"s, selector, existing_docs);
            
            // Build set of existing keys to avoid duplicates
            auto existing_keys_set = std::set<std::string>{};
            if(has_existing and not existing_docs.get<xson::object::array>().empty())
            {
                const auto existing_doc = existing_docs.get<xson::object::array>()[0];
                if(existing_doc.has("keys"s))
                {
                    const auto existing_keys_array = existing_doc["keys"s].get<xson::object::array>();
                    for(const auto& key : existing_keys_array)
                    {
                        if(key.is_string())
                            existing_keys_set.insert(static_cast<std::string>(key));
                    }
                }
            }
            
            // Convert new keys array to vector, validating and deduplicating
            auto new_keys = std::vector<std::string>{};
            for(const auto& key : keys_array)
            {
                if(not key.is_string())
                {
                    auto error = xson::object{
                        {"error", "Bad Request"s},
                        {"message", "All keys must be strings"s}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
                
                auto key_str = static_cast<std::string>(key);
                
                // Validate key name
                if(key_str.empty() or key_str.size() > yar::db::max_field_name_length)
                {
                    auto error = xson::object{
                        {"error", "Bad Request"s},
                        {"message", "Key name is invalid or too long (max "s + std::to_string(yar::db::max_field_name_length) + " chars)"}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
                
                // Don't allow reserved field names
                if(key_str == yar::db::reserved_field_id)
                {
                    auto error = xson::object{
                        {"error", "Bad Request"s},
                        {"message", "Cannot index reserved field: "s + key_str}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
                
                // Only add if not already in existing keys (deduplicate)
                if(existing_keys_set.find(key_str) == existing_keys_set.end())
                {
                    new_keys.push_back(key_str);
                    existing_keys_set.insert(key_str); // Track for this request too
                }
            }
            
            // If no new keys to add, return existing document
            if(new_keys.empty())
            {
                if(has_existing and not existing_docs.get<xson::object::array>().empty())
                {
                    auto result_document = existing_docs.get<xson::object::array>()[0];
                    
                    // Add OData metadata if requested
                    const auto metadata_level = yar::http::odata::parse_metadata_level(headers);
                    if(metadata_level != yar::http::odata::metadata_level::none)
                    {
                        const auto doc_id = static_cast<xson::integer_type>(result_document["_id"s]);
                        result_document = yar::http::odata::add_metadata(result_document, metadata_level, "_db"s, doc_id);
                    }
                    
                    auto response_headers = ::http::headers{};
                    response_headers.set("location"s, "/_db/"s + collection_name);
                    return response_with_headers{::http::status_ok, xson::json::stringify(result_document), std::make_optional(response_headers)};
                }
                else
                {
                    // No existing document and no new keys - this shouldn't happen but handle gracefully
                    auto error = xson::object{
                        {"error", "Bad Request"s},
                        {"message", "All specified keys already exist or no keys to add"s}
                    };
                    return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
                }
            }
            
            // index() populates new secondaries under the same lock; reindex()
            // still rebuilds/heals from storage.
            const auto indexed = m_engine.index(collection_name, new_keys);
            if(not indexed)
                return database_error_response(indexed.error());
            
            const auto reindexed = m_engine.reindex();
            if(not reindexed)
                return database_error_response(reindexed.error());
            
            // Get the updated _db document to return
            auto db_documents = xson::object{};
            auto found = m_engine.read("_db"s, selector, db_documents);
            
            if(not found or db_documents.get<xson::object::array>().empty())
            {
                auto error = xson::object{
                    {"error", "Internal Server Error"s},
                    {"message", "Failed to retrieve index configuration after update"s}
                };
                return response_with_headers{status_internal_server_error, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            auto result_document = db_documents.get<xson::object::array>()[0];
            
            // Add OData metadata if requested
            const auto metadata_level = yar::http::odata::parse_metadata_level(headers);
            if(metadata_level != yar::http::odata::metadata_level::none)
            {
                const auto doc_id = static_cast<xson::integer_type>(result_document["_id"s]);
                result_document = yar::http::odata::add_metadata(result_document, metadata_level, "_db"s, doc_id);
            }
            
            auto response_headers = ::http::headers{};
            response_headers.set("location"s, "/_db/"s + collection_name);
            
            // Return 200 OK for update (PATCH is always an update operation)
            return response_with_headers{::http::status_ok, xson::json::stringify(result_document), std::make_optional(response_headers)};
        };

        auto patch_index_middlewares = build_middleware_chain(method_patch, "PATCH_INDEX"sv, "PATCH_INDEX_ERROR"sv, true);
        m_server.patch("/_db/[a-z][a-z0-9]*"s).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(patch_index_handler, patch_index_middlewares));


        // Update aka replace _id (upsert behavior) - Refactored to use middleware pattern
        // Route pattern /[a-z][a-z0-9]*/[0-9]+ ensures uri.path[2] is numeric
        auto put_document_handler = [this](::http::request_view request, ::http::body_view body, ::http::headers& headers)
        {
            // Validate body is not empty
            if(body.empty())
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "Request body is required"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }

            const auto uri = ::http::uri{request};
            auto document = xson::json::parse(body);
            const auto id = utils::stoll(uri.path[2]); // Regex ensures numeric format

            // Ensure the document has the correct _id from the URL
            document["_id"s] = id;

            const auto selector = xson::object{"_id", id};
            const auto collection = validate_collection_name(uri.path[1]);
            auto response_headers = ::http::headers{};
            const auto resource_path = "/"s + collection + "/"s + std::to_string(id);
            const auto preconditions = put_preconditions_from_headers(headers);

            // Persist under one engine lock so existence, If-Match / If-None-Match,
            // and create/replace cannot race a concurrent writer.
            auto revision = yar::db::document_revision{};
            const auto outcome = m_engine.put(
                collection, selector, document, preconditions, &revision);
            if(not outcome)
                return database_error_response(outcome.error());

            if(revision.position.has_value())
            {
                auto new_etag = generate_etag(revision.position.value());
                response_headers.set("etag"s, new_etag);
            }

            yar::http::odata::add_metadata_if_requested(document, headers, collection, id);
            if(*outcome == yar::db::put_outcome::created)
            {
                response_headers.set("location"s, resource_path);
                return response_with_headers{
                    status_created,
                    xson::json::stringify(document),
                    std::make_optional(response_headers)};
            }

            response_headers.set("content-location"s, resource_path);
            return response_with_headers{
                ::http::status_ok,
                xson::json::stringify(document),
                std::make_optional(response_headers)};
        };

        auto put_document_middlewares = build_middleware_chain(method_put, "PUT_DOCUMENT"sv, "PUT_DOCUMENT_ERROR"sv, true);
        m_server.put(collection_route_with_id).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(put_document_handler, put_document_middlewares));

        // Update aka modify _id - Refactored to use middleware pattern
        // Route pattern /[a-z][a-z0-9]*/[0-9]+ ensures uri.path[2] is numeric
        auto patch_document_handler = [this](::http::request_view request, ::http::body_view body, ::http::headers& headers)
        {
            // Validate body is not empty
            if(body.empty())
            {
                auto error = xson::object{
                    {"error", "Bad Request"s},
                    {"message", "Request body is required"s}
                };
                return response_with_headers{status_bad_request, xson::json::stringify(error), std::optional<::http::headers>{}};
            }
            
            const auto uri = ::http::uri{request};
            auto updates = xson::json::parse(body);
            auto documents = xson::object{};
            const auto id = utils::stoll(uri.path[2]); // Regex ensures numeric format
            const auto selector = xson::object{"_id", id};
            const auto collection = validate_collection_name(uri.path[1]);
            auto existing_docs = xson::object{};
            const auto exists = m_engine.read(collection, selector, existing_docs);
            if(not exists or existing_docs.get<xson::object::array>().empty())
            {
                auto error = xson::object{
                    {"error", "Not Found"s},
                    {"message", "Document not found"s},
                    {"collection", collection},
                    {"id", id}
                };
                return response_with_headers{
                    status_not_found,
                    xson::json::stringify(error),
                    std::optional<::http::headers>{}};
            }

            const auto preconditions = write_preconditions_from_headers(headers);
            auto revision = yar::db::document_revision{};
            const auto updated = m_engine.update(
                collection, selector, updates, documents, preconditions, &revision);
            if(not updated)
                return database_error_response(updated.error());
            if(*updated == 0)
            {
                auto error = xson::object{
                    {"error", "Not Found"s},
                    {"message", "Document not found"s},
                    {"collection", collection},
                    {"id", id}
                };
                return response_with_headers{
                    status_not_found,
                    xson::json::stringify(error),
                    std::optional<::http::headers>{}};
            }

            // Add OData metadata if requested
            auto metadata_level = yar::http::odata::parse_metadata_level(headers);
            if(metadata_level != yar::http::odata::metadata_level::none)
            {
                if(documents.is_array() and not documents.get<xson::object::array>().empty())
                {
                    // PATCH returns array with updated document(s)
                    auto& items = documents.get<xson::object::array>();
                    for(auto& item : items)
                    {
                        item = yar::http::odata::add_metadata(item, metadata_level, collection, id);
                    }
                }
                else if(not documents.is_array())
                {
                    // Single object
                    documents = yar::http::odata::add_metadata(documents, metadata_level, collection, id);
                }
            }
            
            // Add Content-Location header for updated resource
            auto response_headers = ::http::headers{};
            response_headers.set("content-location"s, "/"s + collection + "/"s + std::to_string(id));
            
            // ETag from the revision written with this update (not a later re-read)
            if(revision.position.has_value())
            {
                auto new_etag = generate_etag(revision.position.value());
                response_headers.set("etag"s, new_etag);
            }
            
            return response_with_headers{::http::status_ok, xson::json::stringify(documents), std::make_optional(response_headers)};
        };

        auto patch_document_middlewares = build_middleware_chain(method_patch, "PATCH_DOCUMENT"sv, "PATCH_DOCUMENT_ERROR"sv, true);
        m_server.patch(collection_route_with_id).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(patch_document_handler, patch_document_middlewares));

        // Delete _id - Refactored to use middleware pattern
        // Route pattern /[a-z][a-z0-9]*/[0-9]+ ensures uri.path[2] is numeric
        auto delete_document_handler = [this](::http::request_view request, [[maybe_unused]] ::http::body_view body, [[maybe_unused]] ::http::headers& headers)
        {
            const auto ctx = handler_context{request, m_engine};
            const auto id = utils::stoll(ctx.uri.path[2]); // Regex ensures numeric format
            auto documents = xson::object{};
            const auto selector = xson::object{"_id", id};
            const auto preconditions = write_preconditions_from_headers(headers);
            const auto deleted = m_engine.destroy(ctx.collection, selector, documents, preconditions);

            if(not deleted)
                return database_error_response(deleted.error());

            if(*deleted == 0)
            {
                auto error = xson::object{
                    {"error", "Not Found"s},
                    {"message", "Document not found"s},
                    {"collection", ctx.collection},
                    {"id", id}
                };
                return response_with_headers{status_not_found, xson::json::stringify(error), std::optional<::http::headers>{}};
            }

            // Return 204 No Content for successful deletion
            return response_with_headers{status_no_content, ""s, std::optional<::http::headers>{}};
        };

        auto delete_document_middlewares = build_middleware_chain(method_delete, "DELETE_DOCUMENT"sv, "DELETE_DOCUMENT_ERROR"sv, false);
        m_server.destroy(collection_route_with_id).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(delete_document_handler, delete_document_middlewares));

        // Delete first - Refactored to use middleware pattern
        auto delete_first_handler = [this](::http::request_view request, [[maybe_unused]] ::http::body_view body, [[maybe_unused]] ::http::headers& headers)
        {
            const auto uri = ::http::uri{request};
            auto documents = xson::object{};
            const auto selector = xson::object{"$top", 1ll};
            const auto collection_name = validate_collection_name(uri.path[1]);
            const auto deleted = m_engine.destroy(collection_name, selector, documents);
            if(not deleted)
                return database_error_response(deleted.error());
            return response_with_headers{::http::status_ok, xson::json::stringify(documents), std::optional<::http::headers>{}};
        };

        auto delete_first_middlewares = build_middleware_chain(method_delete, "DELETE_FIRST"sv, "DELETE_FIRST_ERROR"sv, false);
        m_server.destroy("/[a-z]+\\?\\$top"s).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(delete_first_handler, delete_first_middlewares));

        // GET /_reindex - Reindex all collections (rebuild indexes from data) - Refactored to use middleware pattern
        auto reindex_handler = [this]([[maybe_unused]] ::http::request_view request, [[maybe_unused]] ::http::body_view body, ::http::headers& headers)
        {
            // Reindex all collections - this rebuilds indexes from scratch
            const auto reindexed = m_engine.reindex();
            if(not reindexed)
                return database_error_response(reindexed.error());

            auto response = xson::object{
                {"status", "reindexing completed"s},
                {"message", "All collections have been reindexed"s}
            };

            // Add OData metadata if requested
            const auto metadata_level = yar::http::odata::parse_metadata_level(headers);
            if(metadata_level != yar::http::odata::metadata_level::none)
            {
                response["@odata.context"s] = "/$metadata#ReindexResult"s;
            }

            return response_with_headers{status_ok, xson::json::stringify(response), std::optional<::http::headers>{}};
        };

        auto reindex_middlewares = build_middleware_chain(method_get, "REINDEX"sv, "REINDEX_ERROR"sv, false);
        m_server.get("/_reindex"s).response_with_headers(
            "application/json"sv,
            ::http::middleware::wrap(reindex_handler, reindex_middlewares));

        // Explicit OPTIONS handlers: http::server must not answer CORS preflight by
        // invoking GET/POST/PUT/etc (that mutates or leaks when cors_middleware is
        // absent). Register a no-op per path; wrap with CORS when enabled so ACAO
        // is still attached.
        auto options_handler = []([[maybe_unused]] ::http::request_view request,
                                  [[maybe_unused]] ::http::body_view body,
                                  [[maybe_unused]] ::http::headers& headers)
        {
            return response_with_headers{status_no_content, ""s, std::optional<::http::headers>{}};
        };
        auto options_callback = handler{options_handler};
        if(m_cors_enabled)
        {
            if(auto cors_mw = cors_middleware())
            {
                std::array<middleware_factory, 1> options_middlewares{*cors_mw};
                options_callback = ::http::middleware::wrap(options_handler, options_middlewares);
            }
        }
        for(const auto& path : {
                collection_route,
                collection_route_with_query,
                collection_route_with_id,
                "/"s,
                "/health"s,
                "/ready"s,
                "/metrics"s,
                "/\\$metadata"s,
                "/_db/[a-z][a-z0-9]*"s,
                "/_reindex"s})
        {
            m_server.options(path).response_with_headers("*/*"sv, options_callback);
        }

        if(m_mcp_enabled)
            attach_mcp();
        else
            // rebuild_routes / --no-mcp: drop any previously attached MCP
            // callbacks so they cannot outlive a destroyed m_mcp.
            detach_mcp_routes();
    }

    std::string m_file;
    std::string m_bind_host;
    std::string m_port_or_service;
    yar::db::engine m_engine;
    ::http::server m_server;
    bool m_mcp_enabled = true;
    std::unique_ptr<::http::mcp::server> m_mcp;
    std::atomic<server_state> m_state{server_state::stopped};
    std::thread m_listen_thread;
    mutable std::mutex m_start_mutex;
    
    // Rate limiting configuration (optional)
    bool m_rate_limiting_enabled = false;
    std::size_t m_rate_limit_max_requests = 100;
    std::chrono::seconds m_rate_limit_window_seconds{60};
    std::function<std::string(std::string_view request, const ::http::headers&)> m_rate_limit_key_extractor = safe_rate_limit_key_extractor;
    
    // CORS configuration (optional)
    bool m_cors_enabled = false;
    std::function<bool(std::string_view origin)> m_cors_allowed_origin = [](std::string_view) { return true; };
    std::vector<std::string> m_cors_allowed_methods{};
    std::vector<std::string> m_cors_allowed_headers{};
    bool m_cors_allow_credentials = true;
    std::optional<int> m_cors_max_age = std::nullopt;
    
    // Authentication configuration (optional)
    bool m_authentication_enabled = false;
    std::function<bool(std::string_view path)> m_is_public_path = nullptr;
    std::function<bool(std::string_view token)> m_validate_token = nullptr;
    std::function<bool(std::string_view token)> m_validate_admin_token = nullptr;
    std::string m_auth_realm = "YarDB API"s;
};

} // namespace yar::http
