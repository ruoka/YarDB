export module yar:constants;
import std;

export namespace yar::db {

// Reserved field names
inline constexpr auto reserved_field_id = "_id";        // Primary key field in all documents
inline constexpr auto reserved_field_collection = "collection";  // Collection name field in _db documents
inline constexpr auto reserved_field_keys = "keys";     // Secondary keys field in _db documents

// Reserved collection names
inline constexpr auto reserved_collection_db = "_db";  // System collection containing metadata for all collections
inline constexpr auto reserved_collection_health = "health";  // GET /health liveness probe (not a data collection)
inline constexpr auto reserved_collection_ready = "ready";    // GET /ready readiness probe (not a data collection)

// Query parameter limits
inline constexpr long long max_query_top = 10000;           // Maximum value for $top query parameter
inline constexpr long long max_query_skip = 100000;        // Maximum value for $skip query parameter
inline constexpr int max_query_fields = 1000;        // Maximum number of fields in comma-separated lists

// Request limits
inline constexpr std::size_t max_request_body_size = 1024 * 1024; // 1 MiB

// Collection name limits
inline constexpr int max_collection_name_length = 256;  // Maximum length for collection names

// Field name limits
inline constexpr int max_field_name_length = 256;  // Maximum length for field names (e.g., in $orderby)

} // namespace yar::db
