export module yar:odata;
import :details;
import :engine;
import :constants;
import std;
import net;
import xson;

// OData protocol support for HTTP server
// This module contains all OData-specific functionality

namespace yar::http::odata {

using namespace std::string_literals;
using namespace std::string_view_literals;
using namespace net;
using namespace yar::http::details; // Use functions from details module

// Enum for OData metadata level
enum class metadata_level
{
    none,           // No metadata (plain JSON)
    minimal,        // Only @odata.context
    full            // All metadata (@odata.context, @odata.type, @odata.id, etc.)
};

// Helper function to parse OData metadata level from Accept header
// Returns the metadata level requested, or 'none' if not specified
// Note: Header values are already normalized (lowercase) by the http::headers class
inline auto parse_metadata_level(const ::http::headers& headers)
{
    if(not headers.contains("accept"s))
        return metadata_level::none;
    
    const auto accept_value = headers["accept"s];
    
    // Check for odata=fullmetadata
    if(accept_value.contains("odata=fullmetadata"s))
        return metadata_level::full;
    
    // Check for odata=minimalmetadata
    if(accept_value.contains("odata=minimalmetadata"s))
        return metadata_level::minimal;
    
    // Check for odata=nometadata (explicit no metadata)
    if(accept_value.contains("odata=nometadata"s))
        return metadata_level::none;
    
    // Default: no metadata
    return metadata_level::none;
}

// Helper function to add OData metadata to a document based on metadata level
// For minimal metadata: adds @odata.context
// For full metadata: adds @odata.context, @odata.id, @odata.editLink
inline auto add_metadata(xson::object document, metadata_level level, 
                         std::string_view collection_name,
                         std::optional<xson::integer_type> id = std::nullopt)
{
    if(level == metadata_level::none)
        return document; // No metadata needed
    
    // OData context format:
    // - For entity sets (arrays): /$metadata#EntitySetName
    // - For single entities: /$metadata#EntitySetName/$entity
    auto context_url = "/$metadata#"s + std::string{collection_name};
    if(id.has_value())
        context_url += "/$entity"s; // Single entity
    
    if(level == metadata_level::minimal)
    {
        // Minimal metadata: only @odata.context
        document["@odata.context"s] = context_url;
        return document;
    }
    
    // Full metadata: @odata.context, @odata.id, @odata.editLink
    document["@odata.context"s] = context_url;
    
    if(id.has_value())
    {
        auto resource_path = "/"s + std::string{collection_name} + "/"s + std::to_string(id.value());
        document["@odata.id"s] = resource_path;
        document["@odata.editLink"s] = resource_path;
    }
    
    return document;
}

// Helper function to add OData metadata to an array response
// Wraps the array in an object with @odata.context and "value" array
// For full metadata, also adds metadata to each item in the array
inline auto add_metadata_to_array(xson::object document, metadata_level level,
                                   std::string_view collection_name)
{
    if(level == metadata_level::none)
        return document; // No metadata needed
    
    if(not document.is_array())
        return document; // Not an array, return as-is
    
    // Wrap array in object with @odata.context and value
    auto context_url = "/$metadata#"s + std::string{collection_name};
    auto wrapped = xson::object{};
    wrapped["@odata.context"s] = context_url;
    wrapped["value"s] = document;
    
    // For full metadata, also add metadata to each item
    if(level == metadata_level::full)
    {
        auto& items = wrapped["value"s].get<xson::object::array>();
        for(auto& item : items)
        {
            if(item.has("_id"s))
            {
                const xson::integer_type item_id = item["_id"s];
                item = add_metadata(item, level, collection_name, item_id);
            }
        }
    }
    
    return wrapped;
}

// OData string literals escape the delimiter by doubling it ('O''Brien' → O'Brien).
inline std::string unescape_odata_string(std::string_view text, char quote)
{
    auto out = std::string{};
    out.reserve(text.size());

    for(std::size_t i = 0; i < text.size(); ++i)
    {
        if(text[i] == quote and i + 1 < text.size() and text[i + 1] == quote)
        {
            out.push_back(quote);
            ++i;
            continue;
        }
        out.push_back(text[i]);
    }

    return out;
}

// Strip surrounding quotes and unescape doubled delimiters. Returns owned text
// because unescaping may shorten the literal ('' → ').
inline std::string strip_quoted_literal(std::string_view value)
{
    auto trimmed = utils::trim(value);

    if(trimmed.size() >= 2
        and ((trimmed.front() == '\'' and trimmed.back() == '\'')
            or (trimmed.front() == '"' and trimmed.back() == '"')))
    {
        const auto quote = trimmed.front();
        return unescape_odata_string(trimmed.substr(1, trimmed.size() - 2), quote);
    }

    return std::string{trimmed};
}

inline auto parse_string_function_args(std::string_view inner)
{
    auto args = split_outside_quotes(inner, ","sv) | std::ranges::to<std::vector<std::string_view>>();
    if(args.size() != 2)
        throw std::invalid_argument{"Invalid function arguments: "s + std::string{inner}};

    auto field = std::string{utils::trim(args[0])};
    auto value = strip_quoted_literal(args[1]);

    if(field.empty())
        throw std::invalid_argument{"Field name cannot be empty in function arguments: "s + std::string{inner}};

    return std::make_pair(std::move(field), std::move(value));
}

// String filter function type for post-processing
export struct string_filter
{
    std::string_view function;  // "startswith", "contains", "endswith" (string literals)
    std::string field;          // Field name (copied; may be nested path)
    std::string value;          // Filter value (owned so OData '' escapes can be unescaped)
};

// One branch of an OData OR expression (selector AND string filters within the branch)
export struct filter_branch
{
    xson::object selector;
    std::vector<string_filter> string_filters;
};

// Parsed $filter: either a single AND-group or multiple OR branches (OData: AND binds tighter than OR)
export struct parsed_filter
{
    xson::object and_selector;
    std::vector<string_filter> and_string_filters;
    std::vector<filter_branch> or_branches;

    [[nodiscard]] bool has_or() const noexcept
    {
        return not or_branches.empty();
    }
};

// Parse OData 'in' list: ('active','pending') or (1, 2, 3)
inline auto parse_in_value_list(std::string_view list_content)
{
    enum class value_kind { string, integer };
    auto kind = std::optional<value_kind>{};
    auto values = std::vector<xson::object>{};
    auto saw_token = false;

    for(const auto token : split_outside_quotes(list_content, ","sv))
    {
        saw_token = true;
        auto raw = std::string_view{token};

        if(raw.size() >= 2 and
           ((raw.front() == '\'' and raw.back() == '\'') or
            (raw.front() == '"' and raw.back() == '"')))
        {
            const auto quote = raw.front();
            raw = raw.substr(1, raw.size() - 2);
            if(kind and *kind != value_kind::string)
                throw std::invalid_argument{"'in' operator values must be all strings or all numbers"};
            kind = value_kind::string;
            values.emplace_back(unescape_odata_string(raw, quote));
        }
        else
        {
            try
            {
                if(kind and *kind != value_kind::integer)
                    throw std::invalid_argument{"'in' operator values must be all strings or all numbers"};
                kind = value_kind::integer;
                values.emplace_back(utils::stoll(raw));
            }
            catch(const std::invalid_argument&)
            {
                throw;
            }
            catch(...)
            {
                throw std::invalid_argument{"Invalid numeric value in 'in' list: "s + std::string{token}};
            }
        }
    }

    if(not saw_token)
        throw std::invalid_argument{"'in' operator requires at least one value"};

    return values;
}

// Split OData property path: Customer/Country -> ["Customer", "Country"]
inline auto split_property_path(std::string_view path)
{
    auto segments = path
        | std::views::split('/')
        | std::views::transform([](const auto part)
        {
            return utils::trim_end_to_string(std::string_view{part});
        })
        | std::ranges::to<std::vector<std::string>>();

    if(segments.empty())
        throw std::invalid_argument{"Property path cannot be empty"};

    if(std::ranges::any_of(segments, [](const auto& segment) { return segment.empty(); }))
        throw std::invalid_argument{"Invalid property path: "s + std::string{path}};

    return segments;
}

// True when value is a $op constraint map ($gt/$eq/$in/...). Nested document
// selectors use ordinary field names instead.
inline bool is_operator_constraint_map(const xson::object& value)
{
    if(not value.has_objects())
        return false;

    return std::ranges::any_of(
        value.get<db::object::map>(),
        [](const auto& entry)
        {
            return not entry.first.empty() and entry.first.front() == '$';
        });
}

inline xson::object as_operator_constraint_map(const xson::object& leaf)
{
    if(leaf.has_objects())
        return leaf;
    // Bare equality from `field eq value` becomes $eq so it can AND with ranges.
    return xson::object{{"$eq"s, leaf}};
}

// Keep the tighter lower/upper bound when AND merges the same range operator.
inline void tighten_lower_bound(xson::object& target, const xson::object& candidate)
{
    if(xson::primitive_less(target.get<xson::primitive>(), candidate.get<xson::primitive>()))
        target = candidate;
}

inline void tighten_upper_bound(xson::object& target, const xson::object& candidate)
{
    if(xson::primitive_less(candidate.get<xson::primitive>(), target.get<xson::primitive>()))
        target = candidate;
}

// Contradictory predicate that matches no document (used for parent-vs-nested AND).
inline xson::object impossible_predicate()
{
    return xson::object{{"$eq"s, true}, {"$ne"s, true}};
}

inline bool map_contains_value(const xson::object& values, const xson::object& value)
{
    return std::ranges::any_of(
        values.get<db::object::map>() | std::views::values,
        [&](const auto& candidate) { return candidate == value; });
}

// AND of two $in maps is their value intersection. Empty intersection matches
// nothing (xson $in any_of over an empty map is false).
inline void intersect_in_maps(xson::object& target, const xson::object& source)
{
    auto kept = xson::object{};
    // Note: views::enumerate needs libc++ 23; CI/devcontainer stay on Clang 21 for now
    // (apt.llvm.org clang-23 currently segfaults compiling net:http_server_middlewares).
    std::ranges::for_each(
        target.get<db::object::map>()
            | std::views::values
            | std::views::filter([&](const auto& value) { return map_contains_value(source, value); }),
        [&](const auto& value) { kept[std::to_string(kept.size())] = value; });
    target = std::move(kept);
}

inline void add_unique_map_value(xson::object& values, const xson::object& value)
{
    if(not map_contains_value(values, value))
        values[std::to_string(values.size())] = value;
}

inline void union_nin_maps(xson::object& target, const xson::object& source)
{
    std::ranges::for_each(
        source.get<db::object::map>() | std::views::values,
        [&](const auto& value) { add_unique_map_value(target, value); });
}

// Promote a lone $ne into $nin (or add into an existing $nin) so AND of several
// inequalities can exclude every listed value. xson match supports one $ne key
// and a $nin membership map.
inline void merge_ne_into_nin(xson::object& target, const xson::object& excluded)
{
    if(target.has("$nin"s) and target["$nin"s].has_objects())
    {
        add_unique_map_value(target["$nin"s], excluded);
        return;
    }

    if(target.has("$ne"s) and target["$ne"s] != excluded)
    {
        auto nin = xson::object{};
        add_unique_map_value(nin, target["$ne"s]);
        add_unique_map_value(nin, excluded);
        target.get<db::object::map>().erase("$ne"s);
        target["$nin"s] = std::move(nin);
        return;
    }

    target["$ne"s] = excluded;
}

inline void merge_nin_constraint(xson::object& target, const xson::object& nin_values)
{
    if(target.has("$nin"s) and target["$nin"s].has_objects())
    {
        union_nin_maps(target["$nin"s], nin_values);
        return;
    }

    if(target.has("$ne"s))
    {
        auto nin = xson::object{};
        add_unique_map_value(nin, target["$ne"s]);
        union_nin_maps(nin, nin_values);
        target.get<db::object::map>().erase("$ne"s);
        target["$nin"s] = std::move(nin);
        return;
    }

    target["$nin"s] = nin_values;
}

// Merge $op maps on one field. Contradictory equalities become an impossible
// predicate so `status eq 'a' and status eq 'b'` matches nothing. Same-operator
// ranges tighten (max lower / min upper) instead of last-write-wins. Same-field
// $in AND intersects membership sets instead of last-write-wins. Same-field $ne
// AND unions exclusions into $nin instead of last-write-wins.
inline void merge_operator_constraint_maps(xson::object& target, const xson::object& source)
{
    if(target.has("$eq"s) and source.has("$eq"s) and target["$eq"s] != source["$eq"s])
    {
        const auto value = target["$eq"s];
        target = xson::object{{"$eq"s, value}, {"$ne"s, value}};
        return;
    }

    for(const auto& [key, value] : source.get<db::object::map>())
    {
        if(key == "$ne"s)
        {
            merge_ne_into_nin(target, value);
            continue;
        }

        if(key == "$nin"s and value.has_objects())
        {
            merge_nin_constraint(target, value);
            continue;
        }

        if(not target.has(key))
        {
            target[key] = value;
            continue;
        }

        if(key == "$gt"s or key == "$gte"s)
        {
            tighten_lower_bound(target[key], value);
            continue;
        }

        if(key == "$lt"s or key == "$lte"s)
        {
            tighten_upper_bound(target[key], value);
            continue;
        }

        if(key == "$in"s and value.has_objects() and target[key].has_objects())
        {
            intersect_in_maps(target[key], value);
            continue;
        }

        target[key] = value;
    }
}

inline void merge_field_constraints(xson::object& target, const xson::object& source)
{
    auto left = as_operator_constraint_map(target);
    auto right = as_operator_constraint_map(source);
    merge_operator_constraint_maps(left, right);
    target = std::move(left);
}

// Deep-merge selector maps (needed when AND combines Customer/Country and Customer/Name).
// Same-field constraints (bare eq + $gt, or conflicting eq) are AND-merged instead of
// last-write-wins, which previously dropped earlier predicates.
inline void merge_selector_into(xson::object& target, const xson::object& source)
{
    for(const auto& [key, value] : source.get<db::object::map>())
    {
        if(not target.has(key))
        {
            target[key] = value;
            continue;
        }

        auto& dest = target[key];
        const auto dest_is_nested =
            dest.has_objects() and not is_operator_constraint_map(dest);
        const auto source_is_nested =
            value.has_objects() and not is_operator_constraint_map(value);

        if(dest_is_nested and source_is_nested)
        {
            auto nested = dest;
            merge_selector_into(nested, value);
            dest = std::move(nested);
            continue;
        }

        const auto dest_is_constraint =
            dest.has_value() or is_operator_constraint_map(dest);
        const auto source_is_constraint =
            value.has_value() or is_operator_constraint_map(value);

        if(dest_is_constraint and source_is_constraint)
        {
            merge_field_constraints(dest, value);
            continue;
        }

        // Scalar/constraint versus nested path on the same key cannot both hold
        // (Customer eq 'Acme' and Customer/Country eq 'USA'). Last-write-wins
        // previously dropped one side and over-included everyday nested docs.
        if((dest_is_nested and source_is_constraint) or (dest_is_constraint and source_is_nested))
        {
            dest = impossible_predicate();
            continue;
        }

        dest = value;
    }
}

// Set a leaf constraint at a possibly nested path (Customer/Country -> {Customer:{Country:leaf}})
inline void set_nested_selector_leaf(xson::object& selector, std::string_view path, xson::object leaf)
{
    const auto segments = split_property_path(path);

    if(segments.size() == 1)
    {
        if(selector.has(segments[0]))
        {
            auto part = xson::object{};
            part[segments[0]] = std::move(leaf);
            merge_selector_into(selector, part);
        }
        else
            selector[segments[0]] = std::move(leaf);
        return;
    }

    auto nested = std::move(leaf);
    for(auto i = segments.size(); i-- > 1;)
    {
        auto wrapper = xson::object{};
        wrapper[segments[i]] = std::move(nested);
        nested = std::move(wrapper);
    }

    auto top = xson::object{};
    top[segments[0]] = std::move(nested);

    if(not selector.has(segments[0]))
    {
        selector[segments[0]] = std::move(top[segments[0]]);
        return;
    }

    auto& existing = selector[segments[0]];
    const auto existing_is_nested =
        existing.has_objects() and not is_operator_constraint_map(existing);

    // Deep-merge nested paths; scalar/constraint vs nested goes through
    // merge_selector_into so the conflict becomes an impossible predicate.
    if(existing_is_nested)
        merge_selector_into(existing, top[segments[0]]);
    else
        merge_selector_into(selector, top);
}

// Resolve OData nested path (Customer/Name) to a string leaf for post-filters.
// Intermediate segments must be maps; missing path or non-string leaf → nullopt.
inline std::optional<std::string_view> get_string_field_by_path(
    const xson::object& document,
    std::string_view path)
{
    const auto segments = split_property_path(path);
    const auto* current = &document;

    for(std::size_t i = 0; i < segments.size(); ++i)
    {
        const auto& segment = segments[i];
        if(not current->has(segment))
            return std::nullopt;

        const auto& next = (*current)[segment];
        if(i + 1 == segments.size())
        {
            if(not next.is_string())
                return std::nullopt;
            return next.get<std::string>();
        }

        if(not next.has_objects())
            return std::nullopt;

        current = &next;
    }

    return std::nullopt;
}

// Build xson $in map (xson match uses map keys, not arrays)
inline auto make_in_selector(std::string_view field, std::span<const xson::object> values)
{
    auto in_map = xson::object{};
    for(std::size_t i = 0; i < values.size(); ++i)
        in_map[std::to_string(i)] = values[i];

    auto selector = xson::object{};
    set_nested_selector_leaf(selector, field, xson::object{{"$in"s, std::move(in_map)}});
    return selector;
}

using filter_clause = std::pair<xson::object, std::vector<string_filter>>;

// Strip balanced outer parentheses that wrap an entire expression.
// OData clients commonly group with (name eq 'Alice'); without this, the
// leaf parser treats the field as "(name" and the value as "'Alice')" and
// silently matches nothing.
inline std::string_view strip_outer_parens(std::string_view expr)
{
    expr = utils::trim(expr);

    while(expr.size() >= 2 and expr.front() == '(' and expr.back() == ')')
    {
        auto depth = 0;
        auto in_quote = false;
        auto quote_char = char{'\0'};
        auto wraps_entire = true;

        for(auto i = std::size_t{0}; i < expr.size(); ++i)
        {
            const auto c = expr[i];

            if(in_quote)
            {
                if(c == quote_char
                    and i + 1 < expr.size()
                    and expr[i + 1] == quote_char)
                {
                    ++i;
                    continue;
                }

                if(c == quote_char)
                    in_quote = false;

                continue;
            }

            if(c == '\'' or c == '"')
            {
                in_quote = true;
                quote_char = c;
                continue;
            }

            if(c == '(')
                ++depth;
            else if(c == ')')
            {
                --depth;
                if(depth == 0 and i + 1 != expr.size())
                {
                    wraps_entire = false;
                    break;
                }
            }
        }

        if(not wraps_entire or depth != 0 or in_quote)
            break;

        expr = utils::trim(expr.substr(1, expr.size() - 2));
    }

    return expr;
}

// Parse a single leaf $filter expression (no top-level and/or)
inline filter_clause parse_filter_leaf(std::string_view filter_expr)
{
    auto selector = xson::object{};
    auto string_filters = std::vector<string_filter>{};
    auto expr = strip_outer_parens(filter_expr);

    if(expr.empty())
        throw std::invalid_argument{"Invalid filter expression: "s + std::string{filter_expr}};

    // Handle 'in' operator: field in ('a','b') or field in (1, 2, 3)
    // Quote-aware: plain find would hijack contains/eq leaves whose literals contain " in (".
    constexpr auto in_marker = " in ("sv;
    if(const auto in_pos = find_outside_quotes(expr, in_marker))
    {
        if(not expr.ends_with(')'))
            throw std::invalid_argument{"Invalid 'in' expression: "s + std::string{expr}};

        auto field = utils::trim(expr.substr(0, *in_pos));
        if(field.empty())
            throw std::invalid_argument{"Field name cannot be empty in 'in' expression: "s + std::string{expr}};

        const auto list_start = *in_pos + in_marker.size();
        const auto list_content = expr.substr(list_start, expr.size() - list_start - 1);
        const auto values = parse_in_value_list(list_content);
        return std::make_pair(make_in_selector(field, values), string_filters);
    }
    
    // String functions: startswith / contains / endswith(field, 'value')
    for(const auto& [prefix, name] : std::views::zip(
            std::array{"startswith("sv, "contains("sv, "endswith("sv},
            std::array{"startswith"sv, "contains"sv, "endswith"sv}))
    {
        if(expr.starts_with(prefix) and expr.back() == ')')
        {
            auto inner = expr.substr(prefix.size(), expr.size() - prefix.size() - 1);
            auto [field, value] = parse_string_function_args(inner);
            string_filters.push_back(string_filter{name, std::move(field), std::move(value)});
            return std::make_pair(selector, string_filters);
        }
    }
    
    // Find operator for comparison expressions
    // Operators are searched in order of specificity (longer first to avoid partial matches)
    constexpr std::string_view operators[] = {" ge ", " le ", " gt ", " lt ", " ne ", " eq "};
    constexpr std::string_view op_names[] = {"ge", "le", "gt", "lt", "ne", "eq"};
    
    auto op_pos = std::optional<std::size_t>{};
    std::string_view op;

    for(const auto [op_token, op_name] : std::views::zip(operators, op_names))
    {
        if(const auto pos = find_outside_quotes(expr, op_token))
        {
            if(not op_pos or *pos < *op_pos)
            {
                op_pos = pos;
                op = op_name;
            }
        }
    }

    if(not op_pos)
        throw std::invalid_argument{"Invalid filter expression: "s + std::string{expr}};

    const auto field = utils::trim_end(expr.substr(0, *op_pos));
    const auto value_view = utils::trim_start(expr.substr(*op_pos + op.size() + 1));

    // Validate field name is not empty
    if(field.empty())
        throw std::invalid_argument{"Field name cannot be empty in filter expression: "s + std::string{expr}};

    // Quoted values stay strings (including empty ''); strip + unescape into owned text
    const auto is_string = value_view.size() >= 2
        and ((value_view.front() == '\'' and value_view.back() == '\'')
            or (value_view.front() == '"' and value_view.back() == '"'));
    const auto unescaped = is_string
        ? std::optional{strip_quoted_literal(value_view)}
        : std::nullopt;
    const auto value = is_string ? std::string_view{*unescaped} : value_view;

    // Validate value is not empty (empty strings are allowed for string comparisons)
    if(value.empty() and not is_string)
        throw std::invalid_argument{"Filter value cannot be empty in filter expression: "s + std::string{expr}};

    // Unquoted literals: true/false/null, integer, or floating-point. Quoted
    // values stay strings. Bare identifiers that are not literals become strings
    // (legacy); boolean/null must not be stringified or they never match JSON.
    const auto parse_unquoted_literal = [](std::string_view literal)
    {
        const auto box = [](const auto& v)
        {
            auto value = xson::object{};
            value = v;
            return value;
        };

        if(literal == "true"sv)
            return box(true);
        if(literal == "false"sv)
            return box(false);
        if(literal == "null"sv)
            return box(nullptr);

        try
        {
            return box(utils::stoll(literal));
        }
        catch(const std::invalid_argument&)
        {
        }

        auto number = xson::number_type{};
        const auto* begin = literal.data();
        const auto* end = literal.data() + literal.size();
        const auto [ptr, ec] = std::from_chars(begin, end, number);
        if(ec == std::errc{} and ptr == end)
            return box(number);

        return box(std::string{literal});
    };

    const auto require_numeric_literal = [&](std::string_view op_name)
    {
        if(is_string)
            throw std::invalid_argument{
                "Numeric operator '"s + std::string{op_name}
                + "' requires numeric value in filter expression: "s + std::string{expr}};

        auto literal = parse_unquoted_literal(value);
        if(not literal.is_number())
            throw std::invalid_argument{
                "Numeric operator '"s + std::string{op_name}
                + "' requires numeric value in filter expression: "s + std::string{expr}};
        return literal;
    };

    // Convert to selector format (supports nested paths: Customer/Country)
    if(op == "eq")
    {
        if(is_string)
            set_nested_selector_leaf(selector, field, xson::object{*unescaped});
        else
            set_nested_selector_leaf(selector, field, parse_unquoted_literal(value));
    }
    else if(op == "ne")
    {
        if(is_string)
            set_nested_selector_leaf(selector, field, xson::object{{"$ne"s, *unescaped}});
        else
            set_nested_selector_leaf(selector, field, xson::object{{"$ne"s, parse_unquoted_literal(value)}});
    }
    else if(op == "gt")
        set_nested_selector_leaf(selector, field, xson::object{{"$gt"s, require_numeric_literal("gt"sv)}});
    else if(op == "ge")
        set_nested_selector_leaf(selector, field, xson::object{{"$gte"s, require_numeric_literal("ge"sv)}});
    else if(op == "lt")
        set_nested_selector_leaf(selector, field, xson::object{{"$lt"s, require_numeric_literal("lt"sv)}});
    else if(op == "le")
        set_nested_selector_leaf(selector, field, xson::object{{"$lte"s, require_numeric_literal("le"sv)}});
    
    return std::make_pair(selector, string_filters);
}

// Normalize a parsed filter to OR-branch form (single AND becomes one branch).
inline std::vector<filter_branch> as_or_branches(parsed_filter filter)
{
    if(filter.has_or())
        return std::move(filter.or_branches);

    return {
        filter_branch{
            std::move(filter.and_selector),
            std::move(filter.and_string_filters)}};
}

inline parsed_filter parsed_from_branches(std::vector<filter_branch> branches)
{
    if(branches.empty())
        throw std::invalid_argument{"Invalid filter expression"};

    if(branches.size() == 1)
    {
        return parsed_filter{
            std::move(branches[0].selector),
            std::move(branches[0].string_filters),
            {}};
    }

    return parsed_filter{{}, {}, std::move(branches)};
}

// AND two branches by merging selectors and concatenating string filters.
inline filter_branch and_filter_branches(const filter_branch& left, const filter_branch& right)
{
    auto selector = left.selector;
    merge_selector_into(selector, right.selector);

    auto string_filters = left.string_filters;
    string_filters.append_range(right.string_filters);

    return filter_branch{std::move(selector), std::move(string_filters)};
}

// Distribute AND over OR: (A∨B) ∧ (C∨D) → AC∨AD∨BC∨BD.
// Required for parenthesized groups such as `(A or B) and C`.
inline parsed_filter and_parsed_filters(parsed_filter left, parsed_filter right)
{
    const auto left_branches = as_or_branches(std::move(left));
    const auto right_branches = as_or_branches(std::move(right));

    auto combined = std::vector<filter_branch>{};
    combined.reserve(left_branches.size() * right_branches.size());

    for(const auto& left_branch : left_branches)
    {
        for(const auto& right_branch : right_branches)
            combined.push_back(and_filter_branches(left_branch, right_branch));
    }

    return parsed_from_branches(std::move(combined));
}

// Parse OData $filter expression
// Supports: comparisons, in, string functions, and (AND), or (OR — OData precedence: AND before OR)
// Grouping parentheses are honored: top-level and/or splits ignore nested groups, and
// `(A or B) and C` is rewritten to `(A and C) or (B and C)` for the flat OR-branch model.
export inline parsed_filter parse_filter(std::string_view filter_expr)
{
    auto expr = strip_outer_parens(filter_expr);

    if(expr.empty())
        throw std::invalid_argument{"Invalid filter expression: "s + std::string{filter_expr}};

    if(find_outside_quotes_and_parens(expr, " or "sv))
    {
        // Flatten nested OR branches from each part (join of parse → as_or_branches).
        auto branches = split_outside_quotes_and_parens(expr, " or "sv)
            | std::views::transform([](std::string_view part) {
                  return as_or_branches(parse_filter(part));
              })
            | std::views::join
            | std::ranges::to<std::vector<filter_branch>>();

        // Delimiter-only " or " yields no branches; has_or() would be false and
        // the empty and_selector would match every document.
        if(branches.empty())
            throw std::invalid_argument{"Invalid filter expression: "s + std::string{expr}};

        return parsed_from_branches(std::move(branches));
    }

    if(find_outside_quotes_and_parens(expr, " and "sv))
    {
        auto parts = split_outside_quotes_and_parens(expr, " and "sv)
            | std::ranges::to<std::vector<std::string_view>>();
        if(parts.empty())
            throw std::invalid_argument{"Invalid filter expression: "s + std::string{expr}};

        auto merged = parse_filter(parts.front());
        for(const auto part : parts | std::views::drop(1))
            merged = and_parsed_filters(std::move(merged), parse_filter(part));

        return merged;
    }

    auto [selector, string_filters] = parse_filter_leaf(expr);
    return parsed_filter{std::move(selector), std::move(string_filters), {}};
}

// Helper function to apply $select projection to documents
inline auto apply_select(const xson::object& documents, std::string_view select_value)
{
    auto fields = split_outside_quotes(select_value, ","sv) | std::ranges::to<std::vector<std::string_view>>();

    if(fields.empty())
        return documents;

    if(not documents.is_array())
        return documents;

    const auto& docs = documents.get<xson::object::array>();

    auto project = [&fields](const xson::object& doc)
    {
        auto projected = xson::object{};
        if(doc.has("_id"s))
            projected["_id"s] = doc["_id"s];

        for(const auto field : fields)
        {
            if(doc.has(field))
                projected[field] = doc[field];
        }

        return projected;
    };

    return xson::object{
        docs
            | std::views::transform(project)
            | std::ranges::to<xson::object::array>()};
}

// Smallest string strictly greater than all strings with the given prefix (for index range scans)
export inline std::optional<std::string> prefix_exclusive_upper_bound(std::string_view prefix)
{
    if(prefix.empty())
        return std::nullopt;

    auto upper = std::string{prefix};
    while(not upper.empty())
    {
        auto& byte = upper.back();
        if(static_cast<unsigned char>(byte) < 0xFF)
        {
            ++byte;
            return upper;
        }
        upper.pop_back();
    }

    return std::nullopt;
}

// Lower startswith(field, prefix) to indexed {$gte, $lt} range when field is a top-level secondary key
export inline void lower_startswith_filters(
    std::span<const std::string> indexed_keys,
    xson::object& selector,
    std::vector<string_filter>& string_filters)
{
    if(string_filters.empty())
        return;

    const auto indexed = std::unordered_set<std::string>{std::from_range, indexed_keys};

    auto remaining = std::vector<string_filter>{};
    remaining.reserve(string_filters.size());

    for(const auto& filter : string_filters)
    {
        if(filter.function != "startswith"sv or filter.field.contains('/'))
        {
            remaining.push_back(filter);
            continue;
        }

        if(not indexed.contains(filter.field) or selector.has(filter.field))
        {
            remaining.push_back(filter);
            continue;
        }

        const auto& prefix = filter.value;
        const auto upper = prefix_exclusive_upper_bound(prefix);
        if(not upper)
        {
            remaining.push_back(filter);
            continue;
        }

        set_nested_selector_leaf(
            selector,
            filter.field,
            xson::object{{"$gte"s, prefix}, {"$lt"s, *upper}});
    }

    string_filters = std::move(remaining);
}

// True when a document satisfies every post-filter string function
inline auto document_matches_string_filters(
    const xson::object& doc,
    const std::vector<string_filter>& filters)
{
    return std::ranges::all_of(filters, [&](const string_filter& filter)
    {
        const auto field = get_string_field_by_path(doc, filter.field);
        if(not field)
            return false;

        if(filter.function == "startswith"sv)
            return field->starts_with(filter.value);
        if(filter.function == "contains"sv)
            return field->contains(filter.value);
        if(filter.function == "endswith"sv)
            return field->ends_with(filter.value);

        throw std::logic_error{"Unknown string filter function: "s + std::string{filter.function}};
    });
}

// Helper function to apply string filters to documents (post-processing)
inline auto apply_string_filters(const xson::object& documents, const std::vector<string_filter>& filters)
{
    if(filters.empty() or not documents.is_array())
        return documents;

    const auto& docs = documents.get<xson::object::array>();

    return xson::object{
        docs
            | std::views::filter([&](const xson::object& doc)
            {
                return document_matches_string_filters(doc, filters);
            })
            | std::ranges::to<xson::object::array>()};
}

// True when a document matches one OR branch (selector AND branch string filters)
export inline auto document_matches_branch(const xson::object& doc, const filter_branch& branch)
{
    return doc.match(branch.selector)
        and document_matches_string_filters(doc, branch.string_filters);
}

// Union branch results, deduplicating by _id
export inline void merge_or_branch_documents(
    xson::object& merged,
    const xson::object& branch_docs,
    std::unordered_set<xson::integer_type>& seen_ids)
{
    if(not branch_docs.is_array())
        return;

    for(const auto& doc : branch_docs.get<xson::object::array>())
    {
        if(not doc.has("_id"s))
            continue;

        const xson::integer_type id = doc["_id"s];
        if(not seen_ids.insert(id).second)
            continue;

        merged += doc;
    }
}

// Apply $skip then $top to a document array (used after OR branch merge)
export inline auto apply_top_skip(
    xson::object documents,
    xson::integer_type skip,
    xson::integer_type top)
{
    if(not documents.is_array())
        return documents;

    const auto& items = documents.get<xson::object::array>();
    auto skipped = items | std::views::drop(skip > 0 ? static_cast<std::size_t>(skip) : 0u);
    if(top >= 0)
    {
        return xson::object{
            skipped
                | std::views::take(static_cast<std::size_t>(top))
                | std::ranges::to<xson::object::array>()};
    }
    return xson::object{skipped | std::ranges::to<xson::object::array>()};
}

// Peel OData paging/sort keys from a selector so callers can filter first,
// then apply $orderby / $skip / $top (OR path and post-filter AND path).
struct query_paging
{
    xson::integer_type top = std::numeric_limits<xson::integer_type>::max();
    xson::integer_type skip = 0;
    std::string orderby_field;
    bool descending = false;
};

inline query_paging extract_and_strip_paging(xson::object& selector)
{
    auto paging = query_paging{};

    if(not selector.has_objects())
        return paging;

    auto& keys = selector.get<xson::object::map>();

    if(selector.has("$top"s))
    {
        paging.top = selector["$top"s];
        keys.erase("$top"s);
    }
    if(selector.has("$skip"s))
    {
        paging.skip = selector["$skip"s];
        keys.erase("$skip"s);
    }
    if(selector.has("$orderby"s))
    {
        paging.orderby_field = static_cast<std::string>(selector["$orderby"s]);
        keys.erase("$orderby"s);
    }
    if(selector.has("$desc"s))
    {
        paging.descending = true;
        keys.erase("$desc"s);
    }

    return paging;
}

// Filter an in-memory array to documents matching any OR branch (unit tests)
export inline auto filter_documents_by_or(
    const xson::object& documents,
    std::span<const filter_branch> branches)
{
    if(not documents.is_array())
        return documents;

    auto result = xson::object{xson::object::array{}};
    auto seen_ids = std::unordered_set<xson::integer_type>{};

    for(const auto& doc : documents.get<xson::object::array>())
    {
        if(not std::ranges::any_of(branches, [&](const filter_branch& branch)
        {
            return document_matches_branch(doc, branch);
        }))
            continue;

        if(doc.has("_id"s))
        {
            const xson::integer_type id = doc["_id"s];
            if(not seen_ids.insert(id).second)
                continue;
        }

        result += doc;
    }

    return result;
}

// Count documents for $count=true — index-only when the parsed filter allows it
export inline std::size_t count_with_parsed_filter(
    yar::db::engine& engine,
    std::string_view collection,
    xson::object query_selector,
    const parsed_filter& filter)
{
    const auto indexed_keys = engine.indexed_keys(collection);

    if(filter.has_or())
    {
        auto merged = xson::object{xson::object::array{}};
        auto seen_ids = std::unordered_set<xson::integer_type>{};

        for(auto branch : filter.or_branches)
        {
            lower_startswith_filters(indexed_keys, branch.selector, branch.string_filters);
            auto branch_docs = xson::object{};
            engine.read(collection, branch.selector, branch_docs);
            auto filtered = apply_string_filters(branch_docs, branch.string_filters);
            merge_or_branch_documents(merged, filtered, seen_ids);
        }

        if(not merged.is_array())
            return 0;

        return merged.get<xson::object::array>().size();
    }

    merge_selector_into(query_selector, filter.and_selector);

    auto string_filters = filter.and_string_filters;
    lower_startswith_filters(indexed_keys, query_selector, string_filters);

    if(not string_filters.empty())
    {
        // Count must ignore $top/$skip — strip in case a caller left them in.
        std::ignore = extract_and_strip_paging(query_selector);
        auto documents = xson::object{};
        engine.read(collection, query_selector, documents);
        documents = apply_string_filters(documents, string_filters);
        if(not documents.is_array())
            return 0;

        return documents.get<xson::object::array>().size();
    }

    return engine.count(collection, query_selector);
}

// Execute $filter via engine.read — one read per OR branch, merged by _id
export inline auto read_with_parsed_filter(
    yar::db::engine& engine,
    std::string_view collection,
    xson::object query_selector,
    const parsed_filter& filter)
{
    const auto indexed_keys = engine.indexed_keys(collection);

    if(filter.has_or())
    {
        const auto paging = extract_and_strip_paging(query_selector);

        auto merged = xson::object{xson::object::array{}};
        auto seen_ids = std::unordered_set<xson::integer_type>{};

        for(auto branch : filter.or_branches)
        {
            lower_startswith_filters(indexed_keys, branch.selector, branch.string_filters);
            auto branch_docs = xson::object{};
            engine.read(collection, branch.selector, branch_docs);
            auto filtered = apply_string_filters(branch_docs, branch.string_filters);
            merge_or_branch_documents(merged, filtered, seen_ids);
        }

        if(not paging.orderby_field.empty())
            yar::db::apply_orderby(merged, paging.orderby_field, paging.descending);

        return apply_top_skip(merged, paging.skip, paging.top);
    }

    merge_selector_into(query_selector, filter.and_selector);

    auto string_filters = filter.and_string_filters;
    lower_startswith_filters(indexed_keys, query_selector, string_filters);

    // Post-filter functions (contains/endswith/non-indexed startswith) must run
    // before $top/$skip/$orderby. Otherwise paging is applied to the unfiltered
    // scan and matching rows outside the window are silently dropped.
    if(not string_filters.empty())
    {
        const auto paging = extract_and_strip_paging(query_selector);
        auto documents = xson::object{};
        engine.read(collection, query_selector, documents);
        documents = apply_string_filters(documents, string_filters);
        if(not paging.orderby_field.empty())
            yar::db::apply_orderby(documents, paging.orderby_field, paging.descending);
        return apply_top_skip(documents, paging.skip, paging.top);
    }

    auto documents = xson::object{};
    engine.read(collection, query_selector, documents);
    return documents;
}

// Relationship convention (v1): collection names are plural snake_case; a reference
// field is {singular}_id pointing at the related collection's _id. $expand=singular
// loads that document and nests it under the singular navigation name.
//
// Singularize: trailing "ies" → "y"; else strip a single trailing "s" (not "ss").
// Pluralize: consonant+"y" → "ies"; else append "s".

inline auto singularize_collection_name(std::string_view collection)
{
    if(collection.size() >= 3 and collection.ends_with("ies"sv))
        return std::string{collection.substr(0, collection.size() - 3)} + "y";
    if(collection.size() >= 2 and collection.ends_with('s') and not collection.ends_with("ss"sv))
        return std::string{collection.substr(0, collection.size() - 1)};
    return std::string{collection};
}

inline auto pluralize_collection_name(std::string_view singular)
{
    if(singular.size() >= 2 and singular.ends_with('y'))
    {
        const auto before = static_cast<char>(std::tolower(static_cast<unsigned char>(singular[singular.size() - 2])));
        if(not "aeiou"sv.contains(before))
            return std::string{singular.substr(0, singular.size() - 1)} + "ies";
    }
    return std::string{singular} + "s";
}

inline auto is_expand_navigation_name(std::string_view name)
{
    if(name.empty() or name[0] < 'a' or name[0] > 'z')
        return false;

    return std::ranges::all_of(name, [](char c)
    {
        return (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '_';
    });
}

inline auto parse_expand_navigations(std::string_view expand_value)
{
    return split_outside_quotes(expand_value, ","sv)
        | std::views::transform([](const auto part) { return utils::trim(part); })
        | std::views::filter(is_expand_navigation_name)
        | std::views::transform([](const auto name) { return std::string{name}; })
        | std::ranges::to<std::vector<std::string>>();
}

inline void expand_document(xson::object& document, std::string_view navigation, yar::db::engine& engine)
{
    const auto ref_field = std::string{navigation} + "_id";
    if(not document.has(ref_field))
        return;

    const auto& ref = document[ref_field];
    if(not ref.is_integer())
    {
        document[std::string{navigation}] = nullptr;
        return;
    }

    const xson::integer_type related_id = ref;
    const auto related_collection = pluralize_collection_name(navigation);

    try
    {
        validate_collection_name(related_collection);
    }
    catch(const std::invalid_argument&)
    {
        document[std::string{navigation}] = nullptr;
        return;
    }

    auto related_docs = xson::object{};
    const auto selector = xson::object{"_id"s, related_id};
    const auto found = engine.read(related_collection, selector, related_docs);
    if(not found or not related_docs.is_array() or related_docs.get<xson::object::array>().empty())
    {
        document[std::string{navigation}] = nullptr;
        return;
    }

    document[std::string{navigation}] = related_docs.get<xson::object::array>()[0];
}

// Apply $expand using {singular}_id → plural collection _id.
inline auto apply_expand(
    const xson::object& documents,
    std::string_view expand_value,
    [[maybe_unused]] const std::string& collection_name,
    yar::db::engine& engine)
{
    const auto navigations = parse_expand_navigations(expand_value);
    if(navigations.empty())
        return documents;

    auto expand_one = [&](xson::object doc)
    {
        for(const auto& navigation : navigations)
            expand_document(doc, navigation, engine);
        return doc;
    };

    if(documents.is_array())
    {
        const auto& docs = documents.get<xson::object::array>();
        return xson::object{
            docs
                | std::views::transform(expand_one)
                | std::ranges::to<xson::object::array>()};
    }

    if(documents.is_object())
        return expand_one(documents);

    return documents;
}

// OData metadata helper - adds metadata to document if requested
inline void add_metadata_if_requested(
    xson::object& document,
    const ::http::headers& headers,
    const std::string& collection,
    long long id
)
{
    const auto metadata_level = parse_metadata_level(headers);
    if(metadata_level != metadata_level::none)
        document = add_metadata(document, metadata_level, collection, id);
}

// OData query parameter parsing and validation
// These functions parse and validate OData query parameters, throwing std::invalid_argument
// for validation errors. The handler should catch these and return 422 Unprocessable Entity.

// Parse and validate $top parameter
// Throws std::invalid_argument if value is invalid (negative or exceeds maximum)
inline auto parse_top(std::string_view top_value)
{
    const auto value = utils::stoll(top_value);
    if(value < 0)
        throw std::invalid_argument{"$top must be non-negative"};
    if(value > yar::db::max_query_top)
        throw std::invalid_argument{"$top exceeds maximum ("s + std::to_string(yar::db::max_query_top) + ")"};
    return value;
}

// Parse and validate $skip parameter
// Throws std::invalid_argument if value is invalid (negative or exceeds maximum)
inline auto parse_skip(std::string_view skip_value)
{
    const auto value = utils::stoll(skip_value);
    if(value < 0)
        throw std::invalid_argument{"$skip must be non-negative"};
    if(value > yar::db::max_query_skip)
        throw std::invalid_argument{"$skip exceeds maximum ("s + std::to_string(yar::db::max_query_skip) + ")"};
    return value;
}

// Result structure for $orderby parsing
export struct orderby_result
{
    std::string field_name;
    bool descending;
};

// Parse and validate $orderby parameter
// Throws std::invalid_argument if value is invalid (empty field name or too long)
export inline auto parse_orderby(std::string_view orderby_value)
{
    // Check for suffix on original value (before trimming) to handle cases like " desc" or " asc"
    auto field_name = std::string_view{};
    if(orderby_value.ends_with(" desc"sv))
    {
        field_name = utils::trim(orderby_value.substr(0, orderby_value.size() - 5));
    }
    else if(orderby_value.ends_with(" asc"sv))
    {
        field_name = utils::trim(orderby_value.substr(0, orderby_value.size() - 4));
    }
    else
    {
        // No suffix, field_name is the whole trimmed value
        field_name = utils::trim(orderby_value);
    }

    // Validate field name (must not be empty after trimming)
    if(field_name.empty())
        throw std::invalid_argument{"$orderby field name cannot be empty"};

    // Use trimmed value for further processing
    auto orderby = utils::trim(orderby_value);
    
    if(field_name.size() > yar::db::max_field_name_length)
        throw std::invalid_argument{"$orderby field name too long (max "s + std::to_string(yar::db::max_field_name_length) + " chars)"};
    
    // Check if it ends with " desc" or is just "desc"
    const auto descending = orderby.ends_with(" desc"sv) or orderby == "desc"sv;
    
    return orderby_result{std::string{field_name}, descending};
}

// --- $apply (v1): groupby + aggregate ---------------------------------------
// Supports:
//   groupby((status),aggregate(amount with sum as Total))
//   aggregate(amount with sum as Total)
// Methods: sum, average, min, max. Top-level fields only.

export enum class aggregate_method
{
    sum,
    average,
    min,
    max
};

export struct aggregate_clause
{
    std::string field;
    aggregate_method method;
    std::string alias;
};

export struct apply_query
{
    std::vector<std::string> group_fields; // empty → whole-set aggregate
    std::vector<aggregate_clause> aggregates;
};

inline void validate_apply_identifier(std::string_view name, std::string_view what)
{
    if(name.empty())
        throw std::invalid_argument{std::string{what} + " cannot be empty"};
    if(name.size() > yar::db::max_field_name_length)
        throw std::invalid_argument{std::string{what} + " too long"};
    if(name.contains('/'))
        throw std::invalid_argument{std::string{what} + " nested paths are not supported in $apply v1"};
    const auto first = name.front();
    if(not ((first >= 'A' and first <= 'Z') or (first >= 'a' and first <= 'z') or first == '_'))
        throw std::invalid_argument{std::string{what} + " must start with a letter or underscore"};
    for(const auto c : name)
    {
        const auto ok = (c >= 'A' and c <= 'Z')
            or (c >= 'a' and c <= 'z')
            or (c >= '0' and c <= '9')
            or c == '_';
        if(not ok)
            throw std::invalid_argument{std::string{what} + " contains an invalid character"};
    }
}

inline aggregate_method parse_aggregate_method(std::string_view token)
{
    if(token == "sum"sv)
        return aggregate_method::sum;
    if(token == "average"sv)
        return aggregate_method::average;
    if(token == "min"sv)
        return aggregate_method::min;
    if(token == "max"sv)
        return aggregate_method::max;
    throw std::invalid_argument{
        "Unsupported aggregate method '"s + std::string{token}
        + "' (v1 supports sum, average, min, max)"s};
}

export inline aggregate_clause parse_aggregate_clause(std::string_view expr)
{
    auto text = utils::trim(expr);
    constexpr auto prefix = "aggregate("sv;
    if(not text.starts_with(prefix) or not text.ends_with(')'))
        throw std::invalid_argument{"Invalid aggregate(...) expression"};
    auto inner = utils::trim(text.substr(prefix.size(), text.size() - prefix.size() - 1));
    constexpr auto with_tok = " with "sv;
    constexpr auto as_tok = " as "sv;
    const auto with_pos = inner.find(with_tok);
    if(with_pos == std::string_view::npos)
        throw std::invalid_argument{"aggregate requires 'with <method> as <alias>'"};
    auto field = utils::trim(inner.substr(0, with_pos));
    auto rest = utils::trim(inner.substr(with_pos + with_tok.size()));
    const auto as_pos = rest.find(as_tok);
    if(as_pos == std::string_view::npos)
        throw std::invalid_argument{"aggregate requires 'as <alias>'"};
    auto method_tok = utils::trim(rest.substr(0, as_pos));
    auto alias = utils::trim(rest.substr(as_pos + as_tok.size()));
    validate_apply_identifier(field, "$apply aggregate field");
    validate_apply_identifier(alias, "$apply aggregate alias");
    return aggregate_clause{std::string{field}, parse_aggregate_method(method_tok), std::string{alias}};
}

export inline apply_query parse_apply(std::string_view apply_expr)
{
    auto text = utils::trim(apply_expr);
    if(text.empty())
        throw std::invalid_argument{"$apply cannot be empty"};

    apply_query query{};

    if(text.starts_with("aggregate("sv))
    {
        query.aggregates.push_back(parse_aggregate_clause(text));
        return query;
    }

    constexpr auto gb = "groupby("sv;
    if(not text.starts_with(gb) or not text.ends_with(')'))
        throw std::invalid_argument{
            "$apply v1 supports groupby((field),aggregate(...)) or aggregate(...)"};

    // groupby((status),aggregate(...)) → after stripping groupby( … ):
    //   (status),aggregate(...)
    auto inner = utils::trim(text.substr(gb.size(), text.size() - gb.size() - 1));
    if(not inner.starts_with('('))
        throw std::invalid_argument{"$apply groupby requires ((field),aggregate(...))"};
    const auto field_end = inner.find(')');
    if(field_end == std::string_view::npos or field_end < 2)
        throw std::invalid_argument{"$apply groupby missing closing ')' for group field"};
    auto field = utils::trim(inner.substr(1, field_end - 1));
    validate_apply_identifier(field, "$apply groupby field");
    auto after_keys = utils::trim(inner.substr(field_end + 1));
    if(not after_keys.starts_with(','))
        throw std::invalid_argument{"$apply groupby requires aggregate after group keys"};
    auto agg_text = utils::trim(after_keys.substr(1));
    query.group_fields.push_back(std::string{field});
    query.aggregates.push_back(parse_aggregate_clause(agg_text));
    return query;
}

inline std::string group_key_string(const xson::object& value)
{
    if(value.is_null())
        return "\0null"s;
    if(value.is_boolean())
        return static_cast<bool>(value) ? "\0true"s : "\0false"s;
    if(value.is_integer())
        return "\0i:"s + std::to_string(static_cast<xson::integer_type>(value));
    if(value.is_number())
        return "\0n:"s + std::format("{}", static_cast<xson::number_type>(value));
    if(value.is_string())
        return "\0s:"s + static_cast<std::string>(value);
    return "\0other"s;
}

inline xson::object group_key_value(const xson::object& doc, std::string_view field)
{
    if(not doc.has(std::string{field}))
    {
        auto null_value = xson::object{};
        null_value = nullptr;
        return null_value;
    }
    return doc[std::string{field}];
}

// Integer aggregates must not round-trip through double: values beyond 2^53 lose
// low bits, and casting a 2^63 double back to int64 is undefined behavior
// (commonly wrapping to INT64_MIN — a silent sign flip on large sums).
struct aggregate_acc
{
    bool any = false;
    bool all_integer = true;
    bool int_sum_ok = true;
    xson::integer_type int_sum = 0;
    xson::integer_type int_min = 0;
    xson::integer_type int_max = 0;
    double sum = 0.0;
    double min = 0.0;
    double max = 0.0;
    std::size_t count = 0;
};

inline bool checked_add_integer(xson::integer_type a, xson::integer_type b, xson::integer_type& out)
{
    if(b > 0 and a > std::numeric_limits<xson::integer_type>::max() - b)
        return false;
    if(b < 0 and a < std::numeric_limits<xson::integer_type>::min() - b)
        return false;
    out = a + b;
    return true;
}

inline void accumulate_integer(aggregate_acc& acc, xson::integer_type value)
{
    if(not acc.any)
    {
        acc.any = true;
        acc.all_integer = true;
        acc.int_sum_ok = true;
        acc.int_sum = value;
        acc.int_min = value;
        acc.int_max = value;
        acc.sum = static_cast<double>(value);
        acc.min = acc.sum;
        acc.max = acc.sum;
        acc.count = 1;
        return;
    }

    if(acc.all_integer and acc.int_sum_ok)
    {
        auto next = xson::integer_type{0};
        if(checked_add_integer(acc.int_sum, value, next))
            acc.int_sum = next;
        else
            acc.int_sum_ok = false;
        acc.int_min = std::min(acc.int_min, value);
        acc.int_max = std::max(acc.int_max, value);
    }

    const auto as_double = static_cast<double>(value);
    acc.sum += as_double;
    acc.min = std::min(acc.min, as_double);
    acc.max = std::max(acc.max, as_double);
    ++acc.count;
}

inline void accumulate_number(aggregate_acc& acc, double value)
{
    acc.all_integer = false;
    acc.int_sum_ok = false;
    if(not acc.any)
    {
        acc.any = true;
        acc.sum = value;
        acc.min = value;
        acc.max = value;
        acc.count = 1;
        return;
    }
    acc.sum += value;
    acc.min = std::min(acc.min, value);
    acc.max = std::max(acc.max, value);
    ++acc.count;
}

inline bool accumulate_value(aggregate_acc& acc, const xson::object& value)
{
    if(value.is_integer())
    {
        accumulate_integer(acc, static_cast<xson::integer_type>(value));
        return true;
    }
    if(value.is_number())
    {
        accumulate_number(acc, static_cast<double>(static_cast<xson::number_type>(value)));
        return true;
    }
    return false;
}

inline xson::object finish_aggregate(const aggregate_acc& acc, aggregate_method method)
{
    if(not acc.any)
    {
        auto null_value = xson::object{};
        null_value = nullptr;
        return null_value;
    }

    auto result = xson::object{};

    if(acc.all_integer)
    {
        switch(method)
        {
            case aggregate_method::sum:
                if(acc.int_sum_ok)
                {
                    result = acc.int_sum;
                    return result;
                }
                // Sum overflowed int64 — best-effort floating result (no int cast).
                result = static_cast<xson::number_type>(acc.sum);
                return result;
            case aggregate_method::min:
                result = acc.int_min;
                return result;
            case aggregate_method::max:
                result = acc.int_max;
                return result;
            case aggregate_method::average:
            {
                if(acc.int_sum_ok and acc.count > 0 and (acc.int_sum % static_cast<xson::integer_type>(acc.count)) == 0)
                {
                    result = static_cast<xson::integer_type>(acc.int_sum / static_cast<xson::integer_type>(acc.count));
                    return result;
                }
                result = static_cast<xson::number_type>(acc.sum / static_cast<double>(acc.count));
                return result;
            }
        }
    }

    const auto value = [&]() -> double
    {
        switch(method)
        {
            case aggregate_method::sum: return acc.sum;
            case aggregate_method::average: return acc.sum / static_cast<double>(acc.count);
            case aggregate_method::min: return acc.min;
            case aggregate_method::max: return acc.max;
        }
        return acc.sum;
    }();

    // Only emit integer when the value is an exact int64 in the safe double
    // mantissa range — never cast values near ±2^63 (UB / wrap to INT64_MIN).
    constexpr auto max_safe_int = 9007199254740992.0; // 2^53
    constexpr auto min_safe_int = -9007199254740992.0;
    if(std::isfinite(value)
        and std::floor(value) == value
        and value >= min_safe_int
        and value <= max_safe_int)
    {
        result = static_cast<xson::integer_type>(value);
        return result;
    }
    result = static_cast<xson::number_type>(value);
    return result;
}

// Aggregate an array of documents according to a parsed $apply query.
export inline xson::object apply_aggregation(const xson::object& documents, const apply_query& query)
{
    if(query.aggregates.empty())
        throw std::invalid_argument{"$apply requires at least one aggregate"};
    if(not documents.is_array())
        return xson::object{xson::object::array{}};

    struct group_state
    {
        xson::object key_value;
        std::vector<aggregate_acc> accs;
    };

    auto groups = std::map<std::string, group_state>{};
    const auto& items = documents.get<xson::object::array>();

    auto ensure_group = [&](const std::string& key, const xson::object& key_value) -> group_state&
    {
        auto it = groups.find(key);
        if(it != groups.end())
            return it->second;
        auto state = group_state{key_value, std::vector<aggregate_acc>(query.aggregates.size())};
        auto [ins, _] = groups.emplace(key, std::move(state));
        return ins->second;
    };

    if(query.group_fields.empty())
    {
        auto& state = ensure_group(""s, xson::object{});
        for(const auto& doc : items)
        {
            for(auto i = std::size_t{0}; i < query.aggregates.size(); ++i)
            {
                const auto& clause = query.aggregates[i];
                if(not doc.has(clause.field))
                    continue;
                std::ignore = accumulate_value(state.accs[i], doc[clause.field]);
            }
        }
    }
    else
    {
        const auto& gfield = query.group_fields.front();
        for(const auto& doc : items)
        {
            const auto key_value = group_key_value(doc, gfield);
            auto& state = ensure_group(group_key_string(key_value), key_value);
            for(auto i = std::size_t{0}; i < query.aggregates.size(); ++i)
            {
                const auto& clause = query.aggregates[i];
                if(not doc.has(clause.field))
                    continue;
                std::ignore = accumulate_value(state.accs[i], doc[clause.field]);
            }
        }
    }

    auto result = xson::object::array{};
    result.reserve(groups.size());
    for(const auto& [_, state] : groups)
    {
        auto row = xson::object{};
        if(not query.group_fields.empty())
            row[query.group_fields.front()] = state.key_value;
        for(auto i = std::size_t{0}; i < query.aggregates.size(); ++i)
            row[query.aggregates[i].alias] = finish_aggregate(state.accs[i], query.aggregates[i].method);
        result.push_back(std::move(row));
    }
    return xson::object{std::move(result)};
}

// Read matching documents (optional $filter) and run $apply aggregation.
export inline xson::object read_with_apply(
    yar::db::engine& engine,
    std::string_view collection,
    const apply_query& query,
    std::optional<parsed_filter> filter = std::nullopt)
{
    auto documents = xson::object{};
    if(filter)
        documents = read_with_parsed_filter(engine, collection, xson::object{}, *filter);
    else
        engine.read(collection, xson::object{}, documents);
    return apply_aggregation(documents, query);
}

// OData 4.01 JSON CSDL Metadata Generation
// Generates metadata document based on existing collections and their schemas

// Infer EDM (Entity Data Model) type from xson::object value
inline std::string infer_edm_type(const xson::object& value)
{
    if(value.is_null())
        return "Edm.String"s; // Default for null
    
    if(value.is_string())
        return "Edm.String"s;
    if(value.is_integer())
        return "Edm.Int64"s;
    if(value.is_number())
        return "Edm.Double"s;
    if(value.is_boolean())
        return "Edm.Boolean"s;
    if(value.is_object() or value.is_array())
        return "Edm.String"s; // Serialize complex types as JSON string
    
    // Fallback to String
    return "Edm.String"s;
}

// Infer schema from a single document
// Returns Property array with field definitions
inline xson::object::array infer_document_schema(const xson::object& document)
{
    auto properties = xson::object::array{};
    
    // Always include _id as non-nullable Int64 key
    properties.push_back(xson::object{
        {"Name"s, "_id"s},
        {"Type"s, "Edm.Int64"s},
        {"Nullable"s, false}
    });
    
    // Analyze other fields (skip _id which is already added)
    for(const auto& [key, value] : document.get<xson::object::map>())
    {
        if(key == "_id"s)
            continue; // Already added
        
        properties.push_back(xson::object{
            {"Name"s, key},
            {"Type"s, infer_edm_type(value)},
            {"Nullable"s, true} // All fields except _id are nullable
        });
    }
    
    return properties;
}

// Infer schema from collection (use most recent document)
// Requires engine to be locked by caller and collection to be set
inline xson::object::array infer_collection_schema(yar::db::engine& engine, std::string_view collection)
{
    auto selector = xson::object{"$top"s, 1ll};
    auto documents = xson::object{};

    if(engine.read(collection, selector, documents) and documents.is_array() and not documents.get<xson::object::array>().empty())
    {
        const auto& doc = documents.get<xson::object::array>()[0];
        return infer_document_schema(doc);
    }
    
    // No documents in collection - return empty schema with just _id
    return xson::object::array{
        xson::object{
            {"Name"s, "_id"s},
            {"Type"s, "Edm.Int64"s},
            {"Nullable"s, false}
        }
    };
}

// Generate OData 4.01 JSON CSDL metadata
// Creates complete metadata document with EntitySets and EntityTypes
// Requires engine to be locked by caller
export xson::object generate_metadata(yar::db::engine& engine)
{
    auto entity_sets = xson::object::array{};
    auto entity_types = xson::object::array{};
    
    // Get all collections (returns std::vector<std::string>)
    const auto collections_vec = engine.collections();
    
    for(const auto& collection_name : collections_vec)
    {
        // Skip internal collections
        if(collection_name == "_db"s)
            continue;
        
        // Create EntitySet
        entity_sets.push_back(xson::object{
            {"Name"s, collection_name},
            {"EntityType"s, "Default."s + collection_name}
        });
        
        // Infer schema and create EntityType
        auto properties = infer_collection_schema(engine, collection_name);
        
        entity_types.push_back(xson::object{
            {"Name"s, collection_name},
            {"Key"s, xson::object::array{
                xson::object{
                    {"PropertyRef"s, xson::object::array{
                        xson::object{
                            {"Name"s, "_id"s}
                        }
                    }}
                }
            }},
            {"Property"s, properties}
        });
    }
    
    // Build complete metadata document
    return xson::object{
        {"$Version"s, "4.01"s},
        {"$EntityContainer"s, "DefaultContainer"s},
        {"EntitySets"s, entity_sets},
        {"EntityTypes"s, entity_types}
    };
}

} // namespace yar::http::odata

