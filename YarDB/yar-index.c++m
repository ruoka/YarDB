export module yar:index;
import std;
import xson;

using namespace std::string_literals;

namespace yar::db {

using object = xson::object;

using sequence_type = xson::integer_type;

using primary_key_type = sequence_type;

using secondary_index_name = std::string;

using secondary_key_type = xson::primitive;

using position_type = std::streamoff;

using positions_type = std::vector<position_type>;

using primary_index_type = std::flat_map<primary_key_type, position_type>;

// Order integer_type and number_type by numeric value so range queries and
// equality treat JSON doubles and OData integer literals consistently.
using secondary_index_type = std::flat_map<secondary_key_type, positions_type, xson::primitive_less_t>;

using secondary_index_map = std::flat_map<secondary_index_name, secondary_index_type>;

// Walks every stored position for keys in [key_begin, key_end).
class secondary_position_iterator
{
public:

    using difference_type = std::ptrdiff_t;
    using value_type = position_type;
    using iterator_concept = std::forward_iterator_tag;

    secondary_position_iterator() = default;

    secondary_position_iterator(
        secondary_index_type::const_iterator key_begin,
        secondary_index_type::const_iterator key_end) :
        m_key_it{key_begin},
        m_key_end{key_end}
    {
        skip_empty();
    }

    auto operator*() const -> position_type
    {
        return m_key_it->second[m_pos_idx];
    }

    auto& operator++()
    {
        ++m_pos_idx;
        skip_empty();
        return *this;
    }

    auto operator++(int)
    {
        auto tmp = *this;
        ++*this;
        return tmp;
    }

    friend auto operator==(const secondary_position_iterator&, const secondary_position_iterator&) -> bool = default;

private:

    void skip_empty()
    {
        while(m_key_it != m_key_end and m_pos_idx >= m_key_it->second.size())
        {
            m_pos_idx = 0;
            ++m_key_it;
        }
    }

    secondary_index_type::const_iterator m_key_it{};
    secondary_index_type::const_iterator m_key_end{};
    std::size_t m_pos_idx = 0;
};

class reverse_secondary_position_iterator
{
public:

    using difference_type = std::ptrdiff_t;
    using value_type = position_type;
    using iterator_concept = std::forward_iterator_tag;

    reverse_secondary_position_iterator() = default;

    reverse_secondary_position_iterator(
        secondary_index_type::const_reverse_iterator key_begin,
        secondary_index_type::const_reverse_iterator key_end) :
        m_key_it{key_begin},
        m_key_end{key_end}
    {
        if(m_key_it != m_key_end)
            m_pos_idx = m_key_it->second.size() - 1;
        skip_empty();
    }

    auto operator*() const -> position_type
    {
        return m_key_it->second[m_pos_idx];
    }

    auto& operator++()
    {
        if(m_pos_idx > 0)
            --m_pos_idx;
        else
        {
            ++m_key_it;
            if(m_key_it != m_key_end)
                m_pos_idx = m_key_it->second.size() - 1;
        }
        skip_empty();
        return *this;
    }

    auto operator++(int)
    {
        auto tmp = *this;
        ++*this;
        return tmp;
    }

    friend auto operator==(const reverse_secondary_position_iterator&, const reverse_secondary_position_iterator&) -> bool = default;

private:

    void skip_empty()
    {
        while(m_key_it != m_key_end and m_key_it->second.empty())
        {
            ++m_key_it;
            if(m_key_it != m_key_end)
                m_pos_idx = m_key_it->second.size() - 1;
        }
    }

    secondary_index_type::const_reverse_iterator m_key_it{};
    secondary_index_type::const_reverse_iterator m_key_end{};
    std::size_t m_pos_idx = 0;
};

class index_iterator
{
public:

    using difference_type = std::ptrdiff_t;
    using value_type = position_type;
    using iterator_concept = std::forward_iterator_tag;

    enum class kind {primary, secondary, reverse_primary, reverse_secondary};

    using primary_iterator = primary_index_type::const_iterator;

    using reverse_primary_iterator = std::reverse_iterator<primary_iterator>;

    index_iterator() :
        m_state{secondary_position_iterator{}},
        m_kind{kind::secondary}
    {}

    index_iterator(const index_iterator&) = default;

    index_iterator(index_iterator&&) = default;

    index_iterator& operator=(const index_iterator&) = default;

    index_iterator& operator=(index_iterator&&) = default;

    index_iterator(primary_iterator current) :
        m_state{current},
        m_kind{kind::primary}
    {}

    index_iterator(secondary_position_iterator current) :
        m_state{current},
        m_kind{kind::secondary}
    {}

    index_iterator(reverse_primary_iterator current) :
        m_state{current},
        m_kind{kind::reverse_primary}
    {}

    index_iterator(reverse_secondary_position_iterator current) :
        m_state{current},
        m_kind{kind::reverse_secondary}
    {}

    auto operator*() const -> position_type
    {
        switch(m_kind)
        {
        case kind::primary:
            return std::get<primary_iterator>(m_state)->second;
        case kind::secondary:
            return *std::get<secondary_position_iterator>(m_state);
        case kind::reverse_primary:
            return std::get<reverse_primary_iterator>(m_state)->second;
        case kind::reverse_secondary:
            return *std::get<reverse_secondary_position_iterator>(m_state);
        }
        std::unreachable();
    }

    auto& operator++()
    {
        switch(m_kind)
        {
        case kind::primary:
            ++std::get<primary_iterator>(m_state);
            break;
        case kind::secondary:
            ++std::get<secondary_position_iterator>(m_state);
            break;
        case kind::reverse_primary:
            ++std::get<reverse_primary_iterator>(m_state);
            break;
        case kind::reverse_secondary:
            ++std::get<reverse_secondary_position_iterator>(m_state);
            break;
        }
        return *this;
    }

    auto operator++(int)
    {
        auto tmp = *this;
        ++*this;
        return tmp;
    }

    friend auto operator==(const index_iterator& lhs, const index_iterator& rhs) -> bool
    {
        if(lhs.m_kind != rhs.m_kind)
            return false;

        switch(lhs.m_kind)
        {
        case kind::primary:
            return std::get<primary_iterator>(lhs.m_state) == std::get<primary_iterator>(rhs.m_state);
        case kind::secondary:
            return std::get<secondary_position_iterator>(lhs.m_state) == std::get<secondary_position_iterator>(rhs.m_state);
        case kind::reverse_primary:
            return std::get<reverse_primary_iterator>(lhs.m_state) == std::get<reverse_primary_iterator>(rhs.m_state);
        case kind::reverse_secondary:
            return std::get<reverse_secondary_position_iterator>(lhs.m_state) == std::get<reverse_secondary_position_iterator>(rhs.m_state);
        }
        std::unreachable();
    }

    auto operator!=(const index_iterator& itr) const -> bool
    {
        return not(*this == itr);
    }

private:

    std::variant<
        primary_iterator,
        secondary_position_iterator,
        reverse_primary_iterator,
        reverse_secondary_position_iterator> m_state;

    kind m_kind;
};

class index_view : public std::ranges::view_interface<index_view>
{
public:

    template<typename T>
    index_view(T begin, T end, std::optional<std::size_t> known_size = std::nullopt) :
        m_begin{begin},
        m_end{end},
        m_known_size{known_size}
    {}

    auto begin() const
    {
        return m_begin;
    }

    auto end() const
    {
        return m_end;
    }

    // sized_range when known_size is set at construction; otherwise walks iterators
    constexpr auto size() const
    {
        if(m_known_size)
            return *m_known_size;

        auto count = std::size_t{0};
        for(auto it = m_begin; it != m_end; ++it)
            ++count;
        return count;
    }

private:

    index_iterator m_begin, m_end;
    std::optional<std::size_t> m_known_size;
};

// Index for fast document lookup by primary key (_id) and secondary keys
// Maintains primary index (by _id) and secondary indexes (by user-defined fields)
class index
{
public:

    index() = default;

    // Add a single secondary index key
    // @param key Field name to index
    void add(const std::string& key);

    // Add multiple secondary index keys
    // @param keys Field names to index
    void add(std::span<const std::string> keys);

    // Secondary index key names (view into the index; valid while this object lives)
    std::span<const std::string> keys() const;

    // Check if selector uses primary key (_id)
    // @param selector Query selector
    // @return true if selector contains _id field
    bool primary_key(const xson::object& selector) const;

    // Check if selector uses any secondary key
    // @param selector Query selector
    // @return true if selector contains any indexed secondary key field
    bool secondary_key(const xson::object& selector) const;

    // Get index view for querying documents by selector
    // Returns iterator over positions matching the selector
    // @param selector Query selector (can use primary or secondary keys)
    // @return Index view providing iterator over matching document positions
    index_view view(const xson::object& selector) const;

    // Count documents matching the selector
    // Uses index-only counting when the selector is a single indexed constraint;
    // otherwise scans candidate positions and applies document.match
    // @param storage Database file stream for fallback scans
    // @param selector Query selector (ignores $top, $skip, $desc)
    // @return Number of matching documents
    std::size_t count(std::istream& storage, const xson::object& selector) const;

    // Update document and assign _id if missing
    // Increments sequence counter for new _id assignment
    // @param document Document to update (may be modified to add _id)
    void update(xson::object& document);

    // True when a live primary-key entry already exists for id
    bool contains_id(primary_key_type id) const;

    // File position of the live primary-key entry, if present
    std::optional<position_type> position(primary_key_type id) const;

    // Insert document into index with storage position
    // Updates primary key index and all matching secondary key indexes
    // Appends position for duplicate secondary key values
    // @param document Document to index
    // @param position Storage file position where document is stored
    void insert(xson::object& document, position_type position);

    // Erase document from all indexes
    // Removes from primary key index and matching positions in secondary indexes
    // @param document Document to remove from index
    void erase(const xson::object& document);

private:

    xson::integer_type m_sequence = 0;

    primary_index_type m_primary_keys;

    secondary_index_map m_secondary_keys;
};

} // namespace yar::db
