{
  "mcpServers": {
    "yardb": {
      "type": "stdio",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/yardb_mcp.py"],
      "env": {
        "YARDB_URL": "${env:YARDB_URL}",
        "YARDB_PAT": "${env:YARDB_PAT}"
      }
    },
    "yardb-sse": {
      "type": "sse",
      "url": "http://127.0.0.1:8000/sse"
    }
  }
}
