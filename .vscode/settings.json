{
    "files.associations": {
        "*.hpp": "cpp",
        "*.cpp": "cpp",
        "*.c++": "cpp",
        "*.c++m": "cpp",
        "*.test.c++": "cpp"
    },
    "C_Cpp.default.compilerPath": "/usr/bin/clang++-21",
    "C_Cpp.default.compilerArgs": [
        "-std=c++23",
        "-stdlib=libc++",
        "-fexperimental-library",
        "-pthread",
        "-fPIC",
        "-nostdinc++",
        "-isystem",
        "/usr/lib/llvm-21/include/c++/v1",
        "-fprebuilt-module-path=${workspaceFolder}/build-linux-debug/pcm"
    ],
    "C_Cpp.default.cppStandard": "c++23",
    "C_Cpp.default.intelliSenseMode": "linux-clang-x64",
    "C_Cpp.default.includePaths": [
        "${workspaceFolder}/YarDB",
        "${workspaceFolder}/deps/net/net",
        "${workspaceFolder}/deps/xson/xson",
        "${workspaceFolder}/deps/tester/tester",
        "${workspaceFolder}/deps/cryptic/cryptic",
        "/usr/lib/llvm-21/include/c++/v1"
    ],
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.default.defines": [],
    "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": false,
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.defaultProfile.linux": "bash",
    "files.exclude": {
        "**/build-*/**": true,
        "**/obj/**": true,
        "**/pcm/**": true,
        "**/*.o": true,
        "**/*.a": true
    },
    "search.exclude": {
        "**/build-*/**": true,
        "**/obj/**": true,
        "**/pcm/**": true
    }
}
