###############################################################################
# Build Artifacts
###############################################################################

# Build directories
build/
build-*/

# Build subdirectories
obj/
pcm/
bin/
lib/
stamps/

# Compiled object files
*.o
*.a
*.pcm
*.d
*.deps

# Executables (covered by build-*/bin/ pattern above)
# Removed specific executable names to avoid matching substrings in source files
# (e.g., "yardb" was matching "yar-details.c++m")
tools/cb

# CB / clangd artifacts written at the project root
compile_commands.json
graph.json

