export module yar:db_error;
import std;

export namespace yar::db {

// Single-document writes are atomic for detected process-level I/O failures.
// apply_group appends a commit record; reopen discards a group that lacks one.
enum class db_error_code
{
    io_failure,
    rollback_failure,
    corrupt_storage,
    precondition_failed,
    conflict,
    not_found
};

enum class db_operation
{
    create,
    update,
    destroy,
    replace,
    index,
    reindex,
    batch
};

struct db_error
{
    db_error_code code;
    db_operation operation;
    std::string message;
    std::optional<std::size_t> request_index{};
    // Set when a unique-value conflict names an existing document.
    std::optional<std::int64_t> conflict_id{};
};

template<typename T = void>
using db_result = std::expected<T, db_error>;

}
